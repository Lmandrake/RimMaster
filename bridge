#!/usr/bin/env bash
# bridge — who is driving the live RimWorld bridge. The owner's one-word switch.
#
#   ./bridge                 who has it right now (and what for)
#   ./bridge foundry         give it to FOUNDRY
#   ./bridge bench           give it to BENCH
#   ./bridge free            take it off both of them
#
# Sibling of ./game. Agents do NOT use this file — they use the seat commands:
#   python3 src/RimMandrake/rimflow/cli.py bridge who
#   python3 src/RimMandrake/rimflow/cli.py bridge take --for "<what for>"
#   python3 src/RimMandrake/rimflow/cli.py bridge release
#
# The ledger is the truth; infrastructure/state/BRIDGE is a mirror of it that any
# window can read in one glance. `who` re-derives the mirror, so it is never a
# second source of truth to argue with.
set -euo pipefail
cd "$(dirname "$0")"
CLI="src/RimMandrake/rimflow/cli.py"

arg="${1:-}"
case "$(printf '%s' "$arg" | tr '[:upper:]' '[:lower:]')" in
  "")                 exec python3 "$CLI" bridge who --seat OWNER ;;
  who|status)         exec python3 "$CLI" bridge who --seat OWNER ;;
  bench)              shift; exec python3 "$CLI" bridge give BENCH   --seat OWNER "$@" ;;
  foundry)            shift; exec python3 "$CLI" bridge give FOUNDRY --seat OWNER "$@" ;;
  free|none|nobody)   shift; exec python3 "$CLI" bridge give free    --seat OWNER "$@" ;;
  -h|--help|help)
      sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
  *)
      echo "bridge: don't know '$arg'. Try: ./bridge | ./bridge bench | ./bridge foundry | ./bridge free" >&2
      exit 2 ;;
esac
