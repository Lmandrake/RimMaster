						<id>9</id>
						<development IsNull="True" />
					</li>
					<li>
						<foundation Class="IdeoFoundation_Deity">
							<def>Deity</def>
							<place>Oubanyen</place>
							<deities />
						</foundation>
						<name>the Sun-Debt</name>
						<adjective>animist</adjective>
						<memberName>Animist</memberName>
						<leaderTitleMale>War Chief</leaderTitleMale>
						<leaderTitleFemale>War Chief</leaderTitleFemale>
						<description>The sun lends and the sand collects. Every mouthful you drink is borrowed, and the interest is paid in walking, in thirst, and in the marks we cut to remember the walking. A machine that pulls water out of the air is a thief standing between us and what we owe — it does not steal the water, it steals the debt. We take back what was drawn. We never take more than was drawn.</description>
						<descriptionTemplate>Every living thing has a spirit, and the soulless machines disrupt the harmony of the natural world. Spirits become restless when humanity attempts to change them from their true nature. Our universe will finalize when the one people has become strongest of all, and every spirit sees it and bows to them.</descriptionTemplate>
						<culture>Jawa_Culture_DeepDesert</culture>
						<iconDef>sw_SithCrest</iconDef>
						<colorDef>LightMauve</colorDef>
						<primaryFactionColor>RGBA(0.879, 0.705, 0.271, 1.000)</primaryFactionColor>
						<memes>
							<li>Structure_Animist</li>
							<li>PainIsVirtue</li>
							<li>Raider</li>
							<li>NaturePrimacy</li>
							<li>VQE_Technophobia</li>
						</memes>
						<precepts>
							<li>
								<name>raiding</name>
								<def>Raiding_Respected</def>
								<ID>203</ID>
								<randomSeed>1015380233</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li>
								<name>research</name>
								<def>Research_None</def>
								<ID>204</ID>
								<randomSeed>722152617</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li>
								<name>autonomous weapons</name>
								<def>AutonomousWeapons_Prohibited</def>
								<ID>205</ID>
								<randomSeed>-1422114510</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li>
								<name>scarification</name>
								<def>Scarification_Heavy</def>
								<ID>206</ID>
								<randomSeed>-864334881</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li Class="Precept_Ritual">
								<name>Celebration of Simplicity</name>
								<def>Adoption</def>
								<ID>207</ID>
								<randomSeed>-1200941255</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<descOverride>A speaker speaks for a while, then the adoptee lies on the altar and is officially adopted by the parent</descOverride>
								<nameMaker>NamerRitualFestival</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<shortDescOverride>adoption ritual</shortDescOverride>
								<iconPathOverride>UI/Icons/Rituals/Adoption</iconPathOverride>
								<patternGroupTag>Adopt</patternGroupTag>
								<isAnytime>True</isAnytime>
								<canBeAnytime>True</canBeAnytime>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>Adoption</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_AnyGatherSpotOrAltar">
									<def>GatheringSpotOrAltar</def>
									<parent>Precept_207</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior>
									<def>Adopt</def>
								</behavior>
								<triggers>
									<li Class="RitualObligationTrigger_Date">
										<mustBePlayerIdeo>True</mustBePlayerIdeo>
										<triggerDaysSinceStartOfYear>15</triggerDaysSinceStartOfYear>
									</li>
								</triggers>
								<outcomeEffect Class="TPRitualAttachableOutcomes.RitualOutcomeEffectWorker_FromQuality_TP_Custom">
									<def>AdoptionOutcome</def>
									<compDatas>
										<li IsNull="True" />
										<li IsNull="True" />
										<li Class="RitualOutcomeComp_DataThingPresence">
											<presentForTicks>
												<keys />
												<values />
											</presentForTicks>
										</li>
										<li IsNull="True" />
									</compDatas>
								</outcomeEffect>
								<layerWhitelist IsNull="True" />
								<layerBlacklist IsNull="True" />
								<activeObligations IsNull="True" />
								<completedObligations IsNull="True" />
								<lastFinishedTick>-1</lastFinishedTick>
							</li>
