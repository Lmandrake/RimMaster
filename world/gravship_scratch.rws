					<li>
						<foundation Class="IdeoFoundation_Deity">
							<def>Deity</def>
							<place>Chelis</place>
							<deities />
						</foundation>
						<name>Humanitism</name>
						<adjective>humanitist</adjective>
						<memberName>Humanitor</memberName>
						<leaderTitleMale>Cyber Chief</leaderTitleMale>
						<leaderTitleFemale>Cyber Chief</leaderTitleFemale>
						<description>The archotechs' demand is simple: Follow their designated path, and no other. Technology allows humans to be more like the archotechs. In the end, by observing humanity, the archotechs will finally understand their purpose, and lift confident humanity up to rule them.</description>
						<descriptionTemplate>The archotechs' demand is simple: Follow their designated path, and no other. Technology allows humans to be more like the archotechs. In the end, by observing humanity, the archotechs will finally understand their purpose, and lift confident humanity up to rule them.</descriptionTemplate>
						<culture>Corunan</culture>
						<iconDef>sw_Nightsisters</iconDef>
						<colorDef>Orange</colorDef>
						<primaryFactionColor>RGBA(1.000, 1.000, 1.000, 1.000)</primaryFactionColor>
						<memes>
							<li>Structure_Archist</li>
							<li>Loyalist</li>
							<li>Transhumanist</li>
							<li>HumanPrimacy</li>
						</memes>
						<precepts>
							<li Class="Precept_Ritual">
								<name>Burial of Humanitism</name>
								<def>AM_DreadnoughtCryptoFuneral</def>
								<ID>5954</ID>
								<randomSeed>-1626770222</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<nameMaker>NamerRitualFuneral</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>Once a {IDEO} member dies, other {MEMBERS} witnesss {RITUAL_labelDef} to perfectly preserve the body</ritualExpectedDesc>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>AM_CryptoFuneralPattern</sourcePattern>
								<obligationTargetFilter Class="AlphaMemes.RitualObligationTargetWorker_FuneralHolderThings">
									<def>AM_FuneralTargetCrypto</def>
									<parent>Precept_5954</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior Class="AlphaMemes.RitualBehaviorWorker_FuneralFramework">
									<def>AM_CryptoFuneralBehavior</def>
									<corpse>null</corpse>
									<effecterpawn>null</effecterpawn>
									<spawnEffectThings />
								</behavior>
								<triggers />
								<outcomeEffect Class="AlphaMemes.RitualOutcomeEffectWorker_FuneralFramework">
									<def>AM_CryptoFuneralOutcome</def>
									<compDatas>
										<li IsNull="True" />
										<li Class="RitualOutcomeComp_DataThingPresence">
											<presentForTicks>
												<keys />
												<values />
											</presentForTicks>
										</li>
									</compDatas>
								</outcomeEffect>
								<layerWhitelist IsNull="True" />
								<layerBlacklist IsNull="True" />
								<activeObligations IsNull="True" />
								<completedObligations IsNull="True" />
								<lastFinishedTick>-1</lastFinishedTick>
							</li>
							<li Class="Precept_Ritual">
								<name>Requiem of Augmentation</name>
								<def>AM_DreadnoughtFuneral</def>
								<ID>5953</ID>
								<randomSeed>4491691</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<nameMaker>NamerRitualFuneral</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>Once a {IDEO} member dies, other {MEMBERS} witness {RITUAL_labelDef} to see the deceased turned into a true machine of war.</ritualExpectedDesc>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>AM_DreadnoughtFuneralPattern</sourcePattern>
