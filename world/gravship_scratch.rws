						<id>20</id>
						<development IsNull="True" />
					</li>
					<li>
						<foundation Class="IdeoFoundation_Deity">
							<def>Deity</def>
							<place>Ilwaba</place>
							<deities>
								<li>
									<name>Al-Wahhab</name>
									<type>Creator of the Universe</type>
									<gender>Male</gender>
									<iconPath>UI/Deities/DeityGeneric</iconPath>
									<relatedMeme>VME_Scrapper</relatedMeme>
								</li>
							</deities>
						</foundation>
						<name>Ilwaban Doctrine</name>
						<adjective>Trade-Caliphic</adjective>
						<memberName>Trade-Caliphist</memberName>
						<leaderTitleMale>Prime Imam</leaderTitleMale>
						<leaderTitleFemale>Prime Imam</leaderTitleFemale>
						<description>&lt;color=#D09B61FF&gt;Al-Wahhab&lt;/color&gt; taught us to never leave anything to waste: "Squandering is a great sin, for I created the world in my image, and by letting things unused your are also insulting me." Following the teachings of &lt;color=#D09B61FF&gt;Al-Wahhab&lt;/color&gt;, we struggled to become the richest faction of all. Poets will sing about prosperity and opulence long after we are gone. &lt;color=#D09B61FF&gt;Al-Wahhab&lt;/color&gt; saw the light, that it was good: And &lt;color=#D09B61FF&gt;Al-Wahhab&lt;/color&gt; divided the light from the darkness. And &lt;color=#D09B61FF&gt;Al-Wahhab&lt;/color&gt; called the light Day, and the darkness he called Night.</description>
						<descriptionTemplate>%%Deity0_name%% taught us to never leave anything to waste: "Squandering is a great sin, for I created the world in my image, and by letting things unused your are also insulting me." Following the teachings of %%deity0_name%%, we struggled to become the richest faction of all. Poets will sing about prosperity and opulence long after we are gone. %%Deity0_name%% saw the light, that it was good: And %%deity0_name%% divided the light from the darkness. And %%deity0_name%% called the light Day, and the darkness %%deity0_pronoun%% called Night.</descriptionTemplate>
						<culture>Rustican</culture>
						<iconDef>sw_Corellia</iconDef>
						<colorDef>DarkRed</colorDef>
						<primaryFactionColor>RGBA(0.800, 0.788, 0.463, 1.000)</primaryFactionColor>
						<memes>
							<li>Structure_OriginIslamic</li>
							<li>VME_Scrapper</li>
							<li>VME_Trader</li>
							<li>VME_Light</li>
						</memes>
						<precepts>
							<li>
								<name>combat in darkness</name>
								<def>VME_DarknessCombat_Despised</def>
								<ID>2898</ID>
								<randomSeed>1663402469</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li>
								<name>junk</name>
								<def>VME_Junk_Beautiful</def>
								<ID>2899</ID>
								<randomSeed>-897981609</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li Class="Precept_Ritual">
								<name>funeral (no corpse)</name>
								<def>AM_FuneralNoCorpse</def>
								<ID>2905</ID>
								<randomSeed>1779540062</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>Once a {IDEO} member dies and the body is lost, other {MEMBERS} gather around an empty grave for {RITUAL_labelDef}.</ritualExpectedDesc>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>AM_FuneralNoCorpsePattern</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_AnyEmptyGrave">
									<def>AnyEmptyGrave</def>
									<parent>Precept_2905</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior Class="RitualBehaviorWorker_Funeral">
									<def>Funeral</def>
								</behavior>
								<triggers>
									<li Class="AlphaMemes.RitualObligationTrigger_NoCorpse">
										<mustBePlayerIdeo>True</mustBePlayerIdeo>
									</li>
								</triggers>
								<outcomeEffect Class="RitualOutcomeEffectWorker_FromQuality">
									<def>AttendedFuneralNoCorpse</def>
									<compDatas>
										<li IsNull="True" />
										<li Class="RitualOutcomeComp_DataThingPresence">
											<presentForTicks>
												<keys />
												<values />
											</presentForTicks>
										</li>
									</compDatas>
								</outcomeEffect>
								<layerWhitelist IsNull="True" />
								<layerBlacklist IsNull="True" />
								<activeObligations IsNull="True" />
								<completedObligations IsNull="True" />
								<lastFinishedTick>-1</lastFinishedTick>
							</li>
							<li Class="Precept_Ritual">
								<name>Greedy Funeral</name>
								<def>AM_Mummification</def>
								<ID>3005</ID>
								<randomSeed>-55253683</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<nameMaker>NamerRitualFuneral</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>Once a {IDEO} member dies, other {MEMBERS} witness {RITUAL_labelDef} return to dust.</ritualExpectedDesc>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>AM_MummificationPattern</sourcePattern>
								<obligationTargetFilter Class="AlphaMemes.RitualObligationTargetWorker_FuneralThingExtended">
									<def>AM_FuneralExtendedMummification</def>
									<parent>Precept_3005</parent>
									<filters>
										<li Class="RitualObligationTargetWorker_AnyGatherSpotOrAltar">
											<def>GatheringSpotOrAltar</def>
											<parent>Precept_3005</parent>
										</li>
										<li Class="AlphaMemes.RitualObligationTargetWorker_HaveRequiredStuff">
											<def>AM_FuneralTargetMummyStuff</def>
											<parent>Precept_3005</parent>
										</li>
									</filters>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
