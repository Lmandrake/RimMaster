					</li>
					<li>
						<foundation Class="IdeoFoundation_Deity">
							<def>Deity</def>
							<place>Yttak</place>
							<deities>
								<li>
									<name>God</name>
									<type>Universal God</type>
									<gender>Female</gender>
									<iconPath>UI/Deities/DeityGeneric</iconPath>
									<relatedMeme>HAR_Xenophobia</relatedMeme>
								</li>
							</deities>
						</foundation>
						<name>Yttaki Savor</name>
						<adjective>Neo-Orthodox</adjective>
						<memberName>Neo-Orthodoxist</memberName>
						<leaderTitleMale>Great Chief</leaderTitleMale>
						<leaderTitleFemale>Great Chief</leaderTitleFemale>
						<description>&lt;color=#D09B61FF&gt;God&lt;/color&gt; blessed the world with an abundance of flavors and delicacies, declaring that savoring life’s pleasures was her divine purpose for humanity. This is &lt;color=#D09B61FF&gt;God&lt;/color&gt;'s first gift to the Epicureans. &lt;color=#D09B61FF&gt;God&lt;/color&gt; filled the rocks with rich minerals and resources as a gift to those wise enough to dig down to be closer to &lt;color=#D09B61FF&gt;God&lt;/color&gt;. The rest of &lt;color=#D09B61FF&gt;God&lt;/color&gt;'s creations were just made as tools for us, it is her will that we treat them as such.</description>
						<descriptionTemplate>%%Deity0_name%% blessed the world with an abundance of flavors and delicacies, declaring that savoring life’s pleasures was %%deity0_possessive%% divine purpose for humanity. This is %%deity0_name%%'s first gift to the Epicureans. %%Deity0_name%% filled the rocks with rich minerals and resources as a gift to those wise enough to dig down to be closer to %%deity0_name%%. The rest of %%deity0_name%%'s creations were just made as tools for us, it is %%deity0_objective%% will that we treat them as such.</descriptionTemplate>
						<culture>BS_MedievalCulture</culture>
						<iconDef>BS_Antimony</iconDef>
						<colorDef>LightBlue</colorDef>
						<primaryFactionColor>RGBA(0.950, 0.850, 0.500, 1.000)</primaryFactionColor>
						<memes>
							<li>Structure_OriginChristian</li>
							<li>Tunneler</li>
							<li>AM_Epicurean</li>
							<li>HAR_Xenophobia</li>
						</memes>
						<precepts>
							<li>
								<name>alien slavery</name>
								<def>HAR_AlienSlavery_Honorable</def>
								<ID>3208</ID>
								<randomSeed>1564824866</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li Class="Precept_Ritual">
								<name>funeral (no corpse)</name>
								<def>AM_FuneralNoCorpse</def>
								<ID>3214</ID>
								<randomSeed>-1934637421</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>Once a {IDEO} member dies and the body is lost, other {MEMBERS} gather around an empty grave for {RITUAL_labelDef}.</ritualExpectedDesc>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>AM_FuneralNoCorpsePattern</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_AnyEmptyGrave">
									<def>AnyEmptyGrave</def>
									<parent>Precept_3214</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior Class="RitualBehaviorWorker_Funeral">
									<def>Funeral</def>
								</behavior>
								<triggers>
									<li Class="AlphaMemes.RitualObligationTrigger_NoCorpse">
										<mustBePlayerIdeo>True</mustBePlayerIdeo>
									</li>
								</triggers>
								<outcomeEffect Class="RitualOutcomeEffectWorker_FromQuality">
									<def>AttendedFuneralNoCorpse</def>
									<compDatas>
										<li IsNull="True" />
										<li Class="RitualOutcomeComp_DataThingPresence">
											<presentForTicks>
												<keys />
												<values />
											</presentForTicks>
										</li>
									</compDatas>
								</outcomeEffect>
								<layerWhitelist IsNull="True" />
								<layerBlacklist IsNull="True" />
								<activeObligations IsNull="True" />
								<completedObligations IsNull="True" />
								<lastFinishedTick>-1</lastFinishedTick>
							</li>
							<li Class="Precept_Ritual">
								<name>Requiem of Stone</name>
								<def>AM_SkyBurial</def>
								<ID>3311</ID>
								<randomSeed>-315093807</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<nameMaker>NamerRitualFuneral</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>Once a {IDEO} member dies, other {MEMBERS} witnesss {RITUAL_labelDef} to send off their friend to nature</ritualExpectedDesc>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>AM_SkyBurialPattern</sourcePattern>
								<obligationTargetFilter Class="AlphaMemes.RitualObligationTargetWorker_FuneralHolderThings">
									<def>AM_SkyBurialTarget</def>
									<parent>Precept_3311</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior Class="AlphaMemes.RitualBehaviorWorker_SkyBurial">
									<def>AM_SkyBurialBehavior</def>
									<corpse>null</corpse>
									<effecterpawn>null</effecterpawn>
