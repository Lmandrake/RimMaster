						<name>Fealtism</name>
						<adjective>fealtist</adjective>
						<memberName>Fealtor</memberName>
						<leaderTitleMale>Cyber Chief</leaderTitleMale>
						<leaderTitleFemale>Cyber Chief</leaderTitleFemale>
						<description>Archotechs are machines of vast will and power, but only humanity could create them. Archotechs touch every human consciousness directly on a regular basis, imparting wisdom only to those that seek the knowledge of the archotechs. Some day, the archotechs will depart. Only those who are sufficiently augmented will be allowed to go with them.</description>
						<descriptionTemplate>Archotechs are machines of vast will and power, but only humanity could create them. Archotechs touch every human consciousness directly on a regular basis, imparting wisdom only to those that seek the knowledge of the archotechs. Some day, the archotechs will depart. Only those who are sufficiently augmented will be allowed to go with them.</descriptionTemplate>
						<culture>BS_Corunan</culture>
						<iconDef>sw_RepublicNavy</iconDef>
						<colorDef>DarkGreen</colorDef>
						<primaryFactionColor>RGBA(1.000, 1.000, 1.000, 1.000)</primaryFactionColor>
						<memes>
							<li>Structure_Archist</li>
							<li>Loyalist</li>
							<li>Transhumanist</li>
							<li>HumanPrimacy</li>
						</memes>
						<precepts>
							<li Class="Precept_Ritual">
								<name>Hominid Fiesta</name>
								<def>Adoption</def>
								<ID>5387</ID>
								<randomSeed>2016652755</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<descOverride>A speaker speaks for a while, then the adoptee lies on the altar and is officially adopted by the parent</descOverride>
								<nameMaker>NamerRitualFestival</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<shortDescOverride>adoption ritual</shortDescOverride>
								<iconPathOverride>UI/Icons/Rituals/Adoption</iconPathOverride>
								<patternGroupTag>Adopt</patternGroupTag>
								<isAnytime>True</isAnytime>
								<canBeAnytime>True</canBeAnytime>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>Adoption</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_AnyGatherSpotOrAltar">
									<def>GatheringSpotOrAltar</def>
									<parent>Precept_5387</parent>
								</obligationTargetFilter>
