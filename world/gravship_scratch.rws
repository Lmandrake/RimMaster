					</li>
					<li>
						<foundation Class="IdeoFoundation_Deity">
							<def>Deity</def>
							<place>Bagua5</place>
							<deities />
						</foundation>
						<name>The School</name>
						<adjective>fidelist</adjective>
						<memberName>Fidelor</memberName>
						<leaderTitleMale>First Speaker</leaderTitleMale>
						<leaderTitleFemale>First Speaker</leaderTitleFemale>
						<description>The archotechs' demand is simple: Follow their designated path, and no other. Technology allows humans to be more like the archotechs. In the future, by observing humanity, the archotechs will finally understand their purpose, and lift confident humanity up to rule them.</description>
						<descriptionTemplate>The archotechs' demand is simple: Follow their designated path, and no other. Technology allows humans to be more like the archotechs. In the future, by observing humanity, the archotechs will finally understand their purpose, and lift confident humanity up to rule them.</descriptionTemplate>
						<culture>Jawa_Culture_Droid</culture>
						<iconDef>PoliticalE</iconDef>
						<colorDef>LightPurple</colorDef>
						<primaryFactionColor>RGBA(1.000, 1.000, 1.000, 1.000)</primaryFactionColor>
						<memes>
							<li>Structure_Archist</li>
							<li>Loyalist</li>
							<li>Transhumanist</li>
							<li>HumanPrimacy</li>
						</memes>
						<precepts>
							<li Class="Precept_Ritual">
								<name>Machine Jubilee</name>
								<def>Adoption</def>
								<ID>5126</ID>
								<randomSeed>-2049221679</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<descOverride>A speaker speaks for a while, then the adoptee lies on the altar and is officially adopted by the parent</descOverride>
								<nameMaker>NamerRitualFestival</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<shortDescOverride>adoption ritual</shortDescOverride>
								<iconPathOverride>UI/Icons/Rituals/Adoption</iconPathOverride>
								<patternGroupTag>Adopt</patternGroupTag>
								<isAnytime>True</isAnytime>
								<canBeAnytime>True</canBeAnytime>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>Adoption</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_AnyGatherSpotOrAltar">
									<def>GatheringSpotOrAltar</def>
									<parent>Precept_5126</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior>
									<def>Adopt</def>
								</behavior>
								<triggers>
									<li Class="RitualObligationTrigger_Date">
										<mustBePlayerIdeo>True</mustBePlayerIdeo>
										<triggerDaysSinceStartOfYear>56</triggerDaysSinceStartOfYear>
									</li>
								</triggers>
								<outcomeEffect Class="TPRitualAttachableOutcomes.RitualOutcomeEffectWorker_FromQuality_TP_Custom">
									<def>AdoptionOutcome</def>
									<compDatas>
										<li IsNull="True" />
										<li IsNull="True" />
										<li Class="RitualOutcomeComp_DataThingPresence">
											<presentForTicks>
												<keys />
												<values />
											</presentForTicks>
										</li>
										<li IsNull="True" />
									</compDatas>
								</outcomeEffect>
								<layerWhitelist IsNull="True" />
								<layerBlacklist IsNull="True" />
								<activeObligations IsNull="True" />
								<completedObligations IsNull="True" />
								<lastFinishedTick>-1</lastFinishedTick>
							</li>
							<li Class="Precept_Ritual">
								<name>Fidelist Eulogy</name>
								<def>AM_CremateFuneral</def>
								<ID>5232</ID>
								<randomSeed>670436560</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<nameMaker>NamerRitualFuneral</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>Once a {IDEO} member dies, other {MEMBERS} witnesss {RITUAL_labelDef} return to dust.</ritualExpectedDesc>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>AM_CremateFuneralPattern</sourcePattern>
