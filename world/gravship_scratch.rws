						<id>24</id>
						<development IsNull="True" />
					</li>
					<li>
						<foundation Class="IdeoFoundation_Deity">
							<def>Deity</def>
							<place>OuterRim_Chandrila</place>
							<deities />
						</foundation>
						<name>New Order</name>
						<adjective>Imperial</adjective>
						<memberName>Citizen</memberName>
						<leaderTitleMale>Governor</leaderTitleMale>
						<leaderTitleFemale>Governor</leaderTitleFemale>
						<description>"I watched as a general courted favor with his rivals while leaving his battle droids to die on the battlefield. I vowed then to never be like him, knowing that my death, and yours, will mean nothing, as long as our people go on. Now bugger off, and stop shouting. Damn, my poor head..."

  - Abram Kaufman, just before execution</description>
						<descriptionTemplate>"I watched as a general courted favor with his rivals while leaving his battle droids to die on the battlefield. I vowed then to never be like him, knowing that my death, and yours, will mean nothing, as long as our people go on. Now bugger off, and stop shouting. Damn, my poor head..."

  - Abram Kaufman, just before execution</descriptionTemplate>
						<culture>OuterRim_CultureNewOrder</culture>
						<iconDef>OuterRim_Empire</iconDef>
