						<id>21</id>
						<development IsNull="True" />
					</li>
					<li>
						<foundation Class="IdeoFoundation_Deity">
							<def>Deity</def>
							<place>Ilwaba</place>
							<deities />
						</foundation>
						<name>Ilwaban Path</name>
						<adjective>victoryist</adjective>
						<memberName>Victorist</memberName>
						<leaderTitleMale>Laic Overseer</leaderTitleMale>
						<leaderTitleFemale>Laic Overseer</leaderTitleFemale>
						<description>"Atheism is more than just the knowledge that gods do not exist, and that religion is either a mistake or a fraud. Atheism is an attitude. It teaches us one thing: We've long since proven that we have the strength to rightfully rule this universe. That's why we're proud to express the strength of our hearts using the heels of our boots. With or without religion, good people can behave well and bad people can do evil; but for good people to do evil - that takes religion."

  - Alberto 'Philly' Green's discourse on Irreligion</description>
						<descriptionTemplate>"Atheism is more than just the knowledge that gods do not exist, and that religion is either a mistake or a fraud. Atheism is an attitude. It teaches us one thing: We've long since proven that we have the strength to rightfully rule this universe. That's why we're proud to express the strength of our hearts using the heels of our boots. With or without religion, good people can behave well and bad people can do evil; but for good people to do evil - that takes religion."

  - Alberto 'Philly' Green's discourse on Irreligion</descriptionTemplate>
						<culture>Rustican</culture>
						<iconDef>sw_Krayt</iconDef>
						<colorDef>LightSapphire</colorDef>
						<primaryFactionColor>RGBA(0.494, 0.709, 0.986, 1.000)</primaryFactionColor>
						<memes>
							<li>AM_Structure_Atheist</li>
							<li>Supremacist</li>
						</memes>
						<precepts>
							<li>
								<name>slavery</name>
								<def>GarryFlowers_Slavery_Terror</def>
								<ID>3048</ID>
								<randomSeed>-1707462058</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li Class="Precept_Ritual">
								<name>Godless Party</name>
								<def>Adoption</def>
								<ID>3049</ID>
								<randomSeed>1020761628</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<descOverride>A speaker speaks for a while, then the adoptee lies on the altar and is officially adopted by the parent</descOverride>
								<nameMaker>NamerRitualFestival</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<shortDescOverride>adoption ritual</shortDescOverride>
								<iconPathOverride>UI/Icons/Rituals/Adoption</iconPathOverride>
								<patternGroupTag>Adopt</patternGroupTag>
								<canBeAnytime>True</canBeAnytime>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>Adoption</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_AnyGatherSpotOrAltar">
									<def>GatheringSpotOrAltar</def>
									<parent>Precept_3049</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior>
									<def>Adopt</def>
								</behavior>
								<triggers>
									<li Class="RitualObligationTrigger_Date">
										<mustBePlayerIdeo>True</mustBePlayerIdeo>
										<triggerDaysSinceStartOfYear>45</triggerDaysSinceStartOfYear>
									</li>
								</triggers>
								<outcomeEffect Class="TPRitualAttachableOutcomes.RitualOutcomeEffectWorker_FromQuality_TP_Custom">
									<def>AdoptionOutcome</def>
									<compDatas>
										<li IsNull="True" />
										<li IsNull="True" />
										<li Class="RitualOutcomeComp_DataThingPresence">
											<presentForTicks>
												<keys />
												<values />
											</presentForTicks>
										</li>
										<li IsNull="True" />
									</compDatas>
								</outcomeEffect>
								<layerWhitelist IsNull="True" />
								<layerBlacklist IsNull="True" />
								<activeObligations IsNull="True" />
								<completedObligations IsNull="True" />
								<lastFinishedTick>-1</lastFinishedTick>
							</li>
