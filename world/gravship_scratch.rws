					</li>
					<li>
						<foundation Class="IdeoFoundation_Deity">
							<def>Deity</def>
							<place>Boccocarro</place>
							<deities />
						</foundation>
						<name>Hive-Minded Hive</name>
						<adjective>omnist</adjective>
						<memberName>Believer</memberName>
						<leaderTitleMale>Prime Many-as-One</leaderTitleMale>
						<leaderTitleFemale>Prime Many-as-One</leaderTitleFemale>
						<description>Truth can be found in all religions and ideologies, as they are all part of the greater human experience. Whether it is the teachings of the Jewish texts or the philosophies of the ancient Utopian scholars, we can learn about the universe by opening our minds to this truth. We must recognize that all religions contain varying elements of a common truth, and respect all beliefs accordingly.</description>
						<descriptionTemplate>Truth can be found in all religions and ideologies, as they are all part of the greater human experience. Whether it is the teachings of the Jewish texts or the philosophies of the ancient Utopian scholars, we can learn about the universe by opening our minds to this truth. We must recognize that all religions contain varying elements of a common truth, and respect all beliefs accordingly.</descriptionTemplate>
						<culture>Rustican</culture>
						<iconDef>sw_Skywalker</iconDef>
						<colorDef>LightGreen</colorDef>
						<primaryFactionColor>RGBA(0.620, 0.287, 0.503, 1.000)</primaryFactionColor>
						<memes>
							<li>VME_Structure_Omnism</li>
							<li>VME_Gestalt</li>
						</memes>
						<precepts>
							<li Class="Precept_Ritual">
								<name>Comprehensive Eulogy</name>
								<def>AM_CremateFuneral</def>
								<ID>2225</ID>
								<randomSeed>443431988</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<nameMaker>NamerRitualFuneral</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>Once a {IDEO} member dies, other {MEMBERS} witnesss {RITUAL_labelDef} return to dust.</ritualExpectedDesc>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>AM_CremateFuneralPattern</sourcePattern>
								<obligationTargetFilter Class="AlphaMemes.RitualObligationTargetWorker_FuneralThingExtended">
									<def>AM_FuneralExtendedCremate</def>
									<parent>Precept_2225</parent>
									<filters>
										<li Class="AlphaMemes.RitualObligationTargetWorker_FuneralThingNeedsPower">
											<def>AM_FuneralTargetCremate</def>
											<parent>Precept_2225</parent>
										</li>
										<li Class="AlphaMemes.RitualObligationTargetWorker_HaveRequiredStuff">
											<def>AM_FuneralTargetCremateUrnStuff</def>
											<parent>Precept_2225</parent>
										</li>
									</filters>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
