					<li>
						<foundation Class="IdeoFoundation_Deity">
							<def>Deity</def>
							<place>Kemia</place>
							<deities />
						</foundation>
						<name>Mankindism</name>
						<adjective>pro-man</adjective>
						<memberName>Mankindist</memberName>
						<leaderTitleMale>Prime Booster</leaderTitleMale>
						<leaderTitleFemale>Prime Booster</leaderTitleFemale>
						<description>The archotechs' demand is simple: Follow their designated path, and no other. Humans are the device-makers, and the archotechs are their devices. Some day, the archotechs will depart. Only those who are sufficiently augmented will be allowed to go with them.</description>
						<descriptionTemplate>The archotechs' demand is simple: Follow their designated path, and no other. Humans are the device-makers, and the archotechs are their devices. Some day, the archotechs will depart. Only those who are sufficiently augmented will be allowed to go with them.</descriptionTemplate>
						<culture>Rustican</culture>
						<iconDef>Archist_Lance</iconDef>
						<colorDef>DarkTeal</colorDef>
						<primaryFactionColor>RGBA(0.930, 0.590, 0.220, 1.000)</primaryFactionColor>
						<memes>
							<li>Structure_Archist</li>
							<li>Loyalist</li>
							<li>Transhumanist</li>
							<li>HumanPrimacy</li>
						</memes>
						<precepts>
							<li Class="Precept_Ritual">
								<name>Dutiful Fair</name>
								<def>Adoption</def>
								<ID>1211</ID>
								<randomSeed>1959405208</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<descOverride>A speaker speaks for a while, then the adoptee lies on the altar and is officially adopted by the parent</descOverride>
								<nameMaker>NamerRitualFestival</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<shortDescOverride>adoption ritual</shortDescOverride>
								<iconPathOverride>UI/Icons/Rituals/Adoption</iconPathOverride>
								<patternGroupTag>Adopt</patternGroupTag>
								<isAnytime>True</isAnytime>
								<canBeAnytime>True</canBeAnytime>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>Adoption</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_AnyGatherSpotOrAltar">
									<def>GatheringSpotOrAltar</def>
									<parent>Precept_1211</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior>
									<def>Adopt</def>
								</behavior>
								<triggers>
									<li Class="RitualObligationTrigger_Date">
										<mustBePlayerIdeo>True</mustBePlayerIdeo>
										<triggerDaysSinceStartOfYear>19</triggerDaysSinceStartOfYear>
									</li>
								</triggers>
								<outcomeEffect Class="TPRitualAttachableOutcomes.RitualOutcomeEffectWorker_FromQuality_TP_Custom">
									<def>AdoptionOutcome</def>
									<compDatas>
										<li IsNull="True" />
										<li IsNull="True" />
										<li Class="RitualOutcomeComp_DataThingPresence">
											<presentForTicks>
												<keys />
												<values />
											</presentForTicks>
										</li>
										<li IsNull="True" />
									</compDatas>
								</outcomeEffect>
								<layerWhitelist IsNull="True" />
								<layerBlacklist IsNull="True" />
								<activeObligations IsNull="True" />
								<completedObligations IsNull="True" />
								<lastFinishedTick>-1</lastFinishedTick>
							</li>
							<li Class="Precept_Ritual">
								<name>funeral (no corpse)</name>
								<def>AM_FuneralNoCorpse</def>
								<ID>1216</ID>
								<randomSeed>-2133024422</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>Once a {IDEO} member dies and the body is lost, other {MEMBERS} gather around an empty grave for {RITUAL_labelDef}.</ritualExpectedDesc>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>AM_FuneralNoCorpsePattern</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_AnyEmptyGrave">
									<def>AnyEmptyGrave</def>
									<parent>Precept_1216</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior Class="RitualBehaviorWorker_Funeral">
									<def>Funeral</def>
								</behavior>
								<triggers>
