<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RimWorld 1.6 runs Unity/Mono against a .NET Framework 4.7.2 profile, so the
    mod DLL must target net472. There is no Visual Studio or targeting pack on
    this machine, so Microsoft.NETFramework.ReferenceAssemblies supplies the
    reference assemblies from NuGet instead.

    Build:
      "%USERPROFILE%\.dotnet\dotnet.exe" build Source/RimDefDump.csproj -c Release

    Output lands in ../1.6/Assemblies/, which is where RimWorld looks.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimDefDump</AssemblyName>
    <RootNamespace>RimDefDump</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\1.6\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <!-- Nothing but our own DLL should ever be copied next to the mod. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="DefDumper.cs" />
    <Compile Include="DefReflector.cs" />
    <Compile Include="JsonWriter.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Reference the game's own assemblies. Private=false so they are never copied
    into the mod folder: RimWorld already has them loaded, and shipping copies
    is a classic way to break a mod stack.
  -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
