# RimMaster campaign repo — ignore rules
#
# Exclude the entire mod_sources tree. These are ~50 third-party RimWorld mods
# pulled locally for auditing only — licensing + size make them a poor fit for
# the repo. They stay on disk, just untracked.
mod_sources/

# macOS cruft
.DS_Store
**/.DS_Store

# Editor/OS noise
*.swp
*~
Thumbs.db

# Python bytecode
__pycache__/
*.pyc

# Generated report artifacts (reproducible via the Utils/ tools)
*_preview.png
*_legend.json
*_items.md
*_items.json
*_ideoligions.md
*_ideoligions.json

# hand_authored_maps/: study library of downloaded RimWorld .rws maps (~470MB).
# Keep the README manifest in git; the map payloads live on disk only (GDrive).
hand_authored_maps/**/*.rws
hand_authored_maps/**/*.zip
hand_authored_maps/**/*.map
hand_authored_maps/**/*.dll
hand_authored_maps/**/*.exe
hand_authored_maps/**/*.pdb
hand_authored_maps/**/*.cs
hand_authored_maps/**/*.csproj
hand_authored_maps/**/*.config
hand_authored_maps/SickBoyWi_RimWorldMaps/
