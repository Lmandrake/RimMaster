<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  Thought_IkeeWatching.xml                        JawaIkee - new 2026-08-23
  ============================================================================
  Owner, 2026-08-23: "activate the V2 C# build item 'The Ikee's watching me' as a
  positive mood buff for Jawa, Hutt, and other Star Wars aliens known to keep creepy
  pets, but every other xenotype receives a creep factor."

  🔑 THE TOLERANT LIST IS DATA, NOT CODE. It sits on this def as a DefModExtension
  so it can be tuned without rebuilding the assembly. Add or remove <li> entries.

  ⚠️ MayRequire on each entry: every one of these xenotypes comes from
  mandrake.rsw.starwarsraces, so without the guard a mod-list change turns this def into
  a red error at load rather than a shorter list.
  ============================================================================
-->
<Defs>

  <ThoughtDef>
    <defName>RSW_Jawa_IkeeWatching</defName>
    <workerClass>RimMandrake.StarWars.JawaIkee.ThoughtWorker_IkeeNearby</workerClass>
    <validWhileDespawned>false</validWhileDespawned>
    <modExtensions>
      <li Class="RimMandrake.StarWars.JawaIkee.IkeeToleranceExtension">
        <radius>12</radius>
        <tolerantXenotypes>
          <!-- the clan itself -->
          <li MayRequire="mandrake.rsw.starwarsraces">RSW_MandrakeJawa</li>
          <!-- Hutt space: the cartel keeps worse things than this in its palaces -->
          <li MayRequire="mandrake.rsw.starwarsraces">RSW_RimMandrakeHutt</li>
          <li MayRequire="mandrake.rsw.starwarsraces">RSW_RimMandrakeGamorrean</li>
          <li MayRequire="mandrake.rsw.starwarsraces">RSW_RimMandrakeNikto</li>
          <li MayRequire="mandrake.rsw.starwarsraces">RSW_RimMandrakeKlatoonian</li>
          <li MayRequire="mandrake.rsw.starwarsraces">RSW_RimMandrakeWeequay</li>
          <!-- hunters and scavengers who keep live trophies -->
          <li MayRequire="mandrake.rsw.starwarsraces">RSW_RimMandrakeTrandoshan</li>
          <li MayRequire="mandrake.rsw.starwarsraces">RSW_RimMandrakeRodian</li>
          <li MayRequire="mandrake.rsw.starwarsraces">RSW_RimMandrakeAqualish</li>
          <!-- hive-minded: an extra eye is unremarkable -->
          <li MayRequire="mandrake.rsw.starwarsraces">RSW_RimMandrakeGeonosianVariants</li>
        </tolerantXenotypes>
      </li>
    </modExtensions>
    <stages>
      <!-- stage 0 - tolerant -->
      <li>
        <label>ikee underfoot</label>
        <description>There is an ikee nearby, watching everything with that one enormous wet eye. It knows where the good scrap is. It is a comfort, in the way a thing that never blinks can be.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
      <!-- stage 1 - everyone else -->
      <li>
        <label>the ikee is watching me</label>
        <description>There is an ikee nearby. It is mostly eye, it is damp, and it has been looking at me for some time. It has not looked at anything else.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
