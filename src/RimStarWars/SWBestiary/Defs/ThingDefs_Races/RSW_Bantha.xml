<?xml version="1.0" encoding="utf-8"?>
<!--
  MLIE_FAUNA_ABSORPTION_1 — Wave A creature port.
  Ported from mlie.starwarsanimalcollection's `Bantha` ThingDef/PawnKindDef
  pair (Races_Animal_SW.xml), renamed under the RSW_ tier prefix per
  infrastructure/state/facts/mlie_creature_defname_map_wave_a.json.
  Geometry/stats/comps copied verbatim; only defName references were
  repointed to this wave's new names (RSW_Bantha, RSW_WoolBantha,
  RSW_BlueMilk, RSW_Leather_Bantha, RSW_Bantha_Meat, RSW_BanthaHorn) and to
  the already-absorbed sound wave (RSW_Pawn_Bantha_*, see
  mlie_sound_defname_map.json). texPaths are UNCHANGED text — the extracted
  art was placed at the same relative Textures/ path the donor used
  (swanimals/Bantha/..., swresource/...), so no re-pathing was needed.
  `body`, `AnimalThingBase`/`AnimalKindBase`, and every ParentName referenced
  below are vanilla RimWorld (Core), confirmed via RimSage — no donor BodyDef
  is required for this species.
-->
<Defs>
  <ThingDef ParentName="AnimalThingBase">
    <defName>RSW_Bantha</defName>
    <label>bantha</label>
    <description>Banthas are a species of large, hairy mammals with sharp, spiraling horns. They inhabit the desert planet Tatooine, though they are bred on many worlds throughout the galaxy. They are social herd animals, and are often domesticated, and used prominently, by Tusken Raiders as mounts and companionship.</description>
    <statBases>
      <MoveSpeed>4.5</MoveSpeed>
      <ComfyTemperatureMin>-20</ComfyTemperatureMin>
      <ComfyTemperatureMax>80</ComfyTemperatureMax>
      <MarketValue>650</MarketValue>
      <Wildness>0.7</Wildness>
    </statBases>
    <comps>
      <li Class="CompProperties_Shearable">
        <woolDef>RSW_WoolBantha</woolDef>
        <shearIntervalDays>25</shearIntervalDays>
        <woolAmount>100</woolAmount>
      </li>
      <li Class="CompProperties_Milkable">
        <milkDef>RSW_BlueMilk</milkDef>
        <milkIntervalDays>1</milkIntervalDays>
        <milkAmount>15</milkAmount>
      </li>
    </comps>
    <tools>
      <li>
        <label>horns</label>
        <capacities>
          <li>Scratch</li>
          <li>Stab</li>
        </capacities>
        <power>23</power>
        <cooldownTime>2.4</cooldownTime>
        <linkedBodyPartsGroup>HornAttackTool</linkedBodyPartsGroup>
      </li>
      <li>
        <label>horns</label>
