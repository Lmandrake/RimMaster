<!--
  BEASTS_OF_THE_RIM_RETIREMENT, 2026-09-05 — OUR OWN JERBA. New content, not a port.

  Owner's ruling, 2026-09-05: "take what we need from beasts of the rim and retire
  it and free seaswaterline … Let's just add our own jerba." Beasts of the Rim
  (`mlie.beastsoftherim`) shipped a `Jerbal` — an After Man speculative "large
  kangaroo-like gerbil", nothing to do with Star Wars beyond the near-homophone.
  Retiring that mod cost the desert one pack animal, and this def is the
  replacement: an actual JERBA, the shaggy horned Tatooine pack-and-milk beast the
  Tuskens herd alongside their banthas.

  🔑 RECOGNIZABILITY: jerba is an ICONIC Star Wars creature, so
  design/Jawa/worldbuilding/creature_recognizability_rule.md's icon carve-out
  applies — "iconic Star Wars status protects completely", and being instantly
  nameable is the GOAL here, not a defect. That section's corollary is exactly this
  case: an iconic creature missing from the game is an opportunity to build it.

  ART — reused, not generated (owner's instruction). texPath points at
  `swanimals/Bantha/Bantha`, the UNWOOLED bantha sprite already absorbed into this
  mod under MLIE_FAUNA_ABSORPTION_1 (from Star Wars Animal Collection). RSW_Bantha
  itself uses the WOOLED `BanthaW` set in dark browns, so the two do not collide on
  screen: the jerba is the small, pale, short-haired one at roughly a third of the
  bantha's draw size. `BanthaPack_*` carries the loaded-pack render, so the pack
  animal reads correctly too. No new PNG was made and none is needed.

  Jerba is Legends-thin, so the numbers are ours: sized between a vanilla dromedary
  and a muffalo, milkable like the bantha it herds with, a proper pack animal, and
  banded for the desert (ComfyTemperatureMax 60 — the Ash'karr deserts run hot;
  AnimalTolerances_Ashkarr.xml is the biome-fitted band for CAST creatures and does
  not cover this one).

  MeatAmount 196 follows Doctrine/Patches/MegafaunaYield.xml's rule (base =
  unit x bodySize, engine multiplies by bodySize again; unit 140 as the retired
  Jerbal used) rather than being left to default, since bodySize > 1.0.
-->
<Defs>
  <ThingDef ParentName="AnimalThingBase">
    <defName>RSW_Jerba</defName>
    <label>jerba</label>
    <description>A shaggy, short-legged desert grazer with blunt spiralled horns and a hide that sheds sand rather than holding it. Jerba herds trail the banthas across the dune seas, taking the browse the bigger animals leave behind, and desert clans keep them for the same three reasons everywhere: they carry a load without complaint, they give milk on almost no water, and their hide makes hard-wearing leather. They are placid to the point of stubbornness and will plant themselves and refuse to move long before they will kick.</description>
    <statBases>
      <MoveSpeed>3.6</MoveSpeed>
      <ComfyTemperatureMin>-12</ComfyTemperatureMin>
      <ComfyTemperatureMax>60</ComfyTemperatureMax>
      <MarketValue>420</MarketValue>
      <MeatAmount>196</MeatAmount>
      <Wildness>0.45</Wildness>
    </statBases>
    <comps>
      <li Class="CompProperties_Milkable">
        <milkDef>Milk</milkDef>
        <milkIntervalDays>2</milkIntervalDays>
        <milkAmount>8</milkAmount>
      </li>
    </comps>
    <tools>
      <li>
        <label>horns</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>11</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>HornAttackTool</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>7</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
      <li>
        <label>left hoof</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftLeg</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right hoof</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontRightLeg</linkedBodyPartsGroup>
      </li>
    </tools>
    <race>
      <body>QuadrupedAnimalWithHoovesAndHorn</body>
      <herdAnimal>true</herdAnimal>
      <packAnimal>true</packAnimal>
      <baseHungerRate>0.4</baseHungerRate>
      <baseBodySize>1.4</baseBodySize>
      <baseHealthScale>1.4</baseHealthScale>
      <foodType>VegetarianRoughAnimal</foodType>
      <leatherDef>Leather_Camel</leatherDef>
      <gestationPeriodDays>25</gestationPeriodDays>
      <trainability>Advanced</trainability>
      <manhunterOnTameFailChance>0.02</manhunterOnTameFailChance>
      <manhunterOnDamageChance>0.05</manhunterOnDamageChance>
      <lifeExpectancy>30</lifeExpectancy>
      <nuzzleMtbHours>200</nuzzleMtbHours>
      <wildBiomes>
        <!-- Animal-side only. BiomeCast_Ashkarr.xml is the biome-side authority and
             does NOT list RSW_Jerba; declaring the same (animal, biome) pair on both
             sides throws ArgumentException inside BiomeDef.CommonalityOfAnimal.
             See Waterline_Lane1.xml's KwazelMaw note for the same trap. -->
        <Desert>0.4</Desert>
        <ExtremeDesert>0.22</ExtremeDesert>
        <AridShrubland>0.35</AridShrubland>
      </wildBiomes>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.35</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>1.0</minAge>
          <soundWounded>Pawn_Dromedary_Wounded</soundWounded>
          <soundDeath>Pawn_Dromedary_Death</soundDeath>
          <soundCall>Pawn_Dromedary_Call</soundCall>
          <soundAngry>Pawn_Dromedary_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
      <soundEating>Herbivore_Eat</soundEating>
    </race>
    <tradeTags>
      <li>AnimalCommon</li>
      <li>AnimalFarm</li>
    </tradeTags>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>RSW_Jerba</defName>
