<!-- SW_SEA_MONSTERS_ART_1 — scavenger swarm, the bottom-feeders. Numbers per
     sea_beasts_def_spec.md §5.5. Label RENAMED by the owner 2026-09-02:
     "pale yobshrimp" (not "yobshrimp") — SWAC's mlie.starwarsanimalcollection
     Yobshrimp (bs 0.4) stays; ours (RSW_Yobshrimp, bs 0.2) is a different
     animal under a different label, no Cherry Picker cut needed. -->
<Defs>

  <ThingDef ParentName="AnimalThingBase">
    <defName>RSW_Yobshrimp</defName>
    <label>pale yobshrimp</label>
    <description>A pale, feather-antennaed isopod of the Naboo shallows that arrives at a carcass in dozens and leaves a clean frame. Harmless alone; the smell of blood is what makes it many.</description>
    <statBases>
      <MoveSpeed>3.2</MoveSpeed>
      <MarketValue>40</MarketValue>
      <ComfyTemperatureMin>-5</ComfyTemperatureMin>
      <ComfyTemperatureMax>55</ComfyTemperatureMax>
      <ArmorRating_Blunt>0.10</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.20</ArmorRating_Sharp>
      <Wildness>0.8</Wildness>
    </statBases>
    <tools>
      <li>
        <label>mandibles</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>4</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Mouth</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>2</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <race>
      <body>BeetleLike</body>
      <herdAnimal>true</herdAnimal>
      <baseBodySize>0.2</baseBodySize>
      <baseHealthScale>0.35</baseHealthScale>
      <baseHungerRate>0.08</baseHungerRate>
      <foodType>CarnivoreAnimal</foodType>
      <canFishForFood>true</canFishForFood>
      <waterSeeker>true</waterSeeker>
      <waterCellCost>1</waterCellCost>
      <gestationPeriodDays>5.661</gestationPeriodDays>
      <manhunterOnDamageChance>0.2</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0</manhunterOnTameFailChance>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(2.5, 1)</li>
          <li>(3, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeExpectancy>8</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.1</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.25</minAge>
        </li>
      </lifeStageAges>
    </race>
  </ThingDef>

