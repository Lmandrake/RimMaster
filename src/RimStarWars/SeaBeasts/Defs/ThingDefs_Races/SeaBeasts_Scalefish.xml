          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.05</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.15</minAge>
        </li>
