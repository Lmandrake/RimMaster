<?xml version="1.0" encoding="utf-8"?>
<!-- SW_SEA_MONSTERS_ART_1 — colossal neutrals, the great filter-feeders. Body
     Pinniped (Odyssey, Bodies_Animal_Pinniped.xml). Numbers per
     sea_beasts_def_spec.md §5.6. foodType None: they strain plankton the
     game does not model, so EatsFood is false and they carry no food need
     (Pawn_NeedsTracker.cs:358) — same mechanism as the scalefish.

     All three carry a full 4-facing set under
     Things/Pawn/Animal/SeaBeasts/<Slug>/<Slug>. Graphic_Multi fails SILENTLY
     on a missing facing — it renders nothing and no magenta fires — so any
     edit to a texPath here must keep all four files together. -->
<Defs>

  <ThingDef ParentName="AnimalThingBase">
    <defName>RSW_Reefback</defName>
    <label>reefback</label>
    <description>So old the reef grows on it: coral, kelp, a hundred hangers-on that never leave. A moving ecosystem, and the one place in the deep where a crew can rest in the light of something else's garden — as long as nobody puts a harpoon in the garden.</description>
    <statBases>
      <MoveSpeed>2.0</MoveSpeed>
      <MarketValue>8000</MarketValue>
      <ComfyTemperatureMin>-30</ComfyTemperatureMin>
      <ComfyTemperatureMax>50</ComfyTemperatureMax>
      <ArmorRating_Blunt>0.60</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.70</ArmorRating_Sharp>
      <ArmorRating_Heat>0.75</ArmorRating_Heat>
      <Wildness>1.0</Wildness>
    </statBases>
    <tools>
      <li>
        <label>tail sweep</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>480</power>
        <cooldownTime>8.5</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
      </li>
      <li>
        <label>bulk</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>120</power>
        <cooldownTime>6</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
        <chanceFactor>0.3</chanceFactor>
      </li>
    </tools>
    <race>
      <body>Pinniped</body>
      <predator>false</predator>
      <canBePredatorPrey>false</canBePredatorPrey>
      <disableMating>true</disableMating>
      <baseBodySize>32</baseBodySize>
      <baseHealthScale>20</baseHealthScale>
      <foodType>None</foodType>
      <waterSeeker>true</waterSeeker>
      <waterCellCost>1</waterCellCost>
      <gestationPeriodDays>120</gestationPeriodDays>
      <manhunterOnDamageChance>0.2</manhunterOnDamageChance>
      <manhunterOnTameFailChance>1.0</manhunterOnTameFailChance>
      <lifeExpectancy>500</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.2</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.6</minAge>
        </li>
      </lifeStageAges>
    </race>
  </ThingDef>

