<Defs>

  <ThingDef ParentName="AnimalThingBase">
    <defName>RSW_OpeeSeaKiller</defName>
    <label>opee sea killer</label>
    <description>A brown-armored ambusher of the Naboo core-seas, part crab, part angler. It buries itself in the silt with only its lure stalks showing, then takes prey on an adhesive tongue faster than a diver can turn. Twenty metres of patience; it has never needed to chase anything.</description>
    <statBases>
      <MoveSpeed>3.0</MoveSpeed>
      <MarketValue>400</MarketValue>
      <ComfyTemperatureMin>-5</ComfyTemperatureMin>
      <ComfyTemperatureMax>55</ComfyTemperatureMax>
      <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.45</ArmorRating_Sharp>
      <ArmorRating_Heat>0.21</ArmorRating_Heat>
      <Wildness>0.9</Wildness>
    </statBases>
    <tools>
      <li>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>21</power>
        <cooldownTime>1.8</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
      </li>
      <li>
        <label>left claw</label>
        <labelNoLocation>claw</labelNoLocation>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftClaws</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right claw</label>
        <labelNoLocation>claw</labelNoLocation>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontRightClaws</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>6</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <race>
      <body>Crab</body>
      <predator>true</predator>
      <maxPreyBodySize>1.2</maxPreyBodySize>
      <baseBodySize>1.4</baseBodySize>
      <baseHealthScale>1.4</baseHealthScale>
      <baseHungerRate>0.25</baseHungerRate>
      <foodType>CarnivoreAnimal</foodType>
      <canFishForFood>true</canFishForFood>
      <leatherDef>Leather_Lizard</leatherDef>
      <waterSeeker>true</waterSeeker>
      <waterCellCost>1</waterCellCost>
      <gestationPeriodDays>10</gestationPeriodDays>
      <manhunterOnDamageChance>0.5</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.3</manhunterOnTameFailChance>
      <lifeExpectancy>40</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.1</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.3333</minAge>
        </li>
      </lifeStageAges>
    </race>
  </ThingDef>

