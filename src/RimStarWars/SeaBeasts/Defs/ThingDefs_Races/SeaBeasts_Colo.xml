<Defs>

  <ThingDef ParentName="AnimalThingBase">
    <defName>RSW_ColoClawFish</defName>
    <label>colo claw fish</label>
    <description>A pale cave eel of the Naboo underworld, forty metres from lure to tail, with a pair of clawed forelimbs it uses to pin what its whisker-lures draw in. Its jaw distends to swallow prey larger than itself. It hunts from the dark just past the edge of your light.</description>
    <statBases>
      <MoveSpeed>4.0</MoveSpeed>
      <MarketValue>800</MarketValue>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <ComfyTemperatureMax>50</ComfyTemperatureMax>
      <ArmorRating_Blunt>0.15</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.25</ArmorRating_Sharp>
      <Wildness>0.95</Wildness>
    </statBases>
    <tools>
      <li>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>45</power>
        <cooldownTime>2.6</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
      </li>
      <li>
        <label>left claw</label>
        <labelNoLocation>claw</labelNoLocation>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>15</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftClaws</linkedBodyPartsGroup>
      </li>
      <li>
        <label>right claw</label>
        <labelNoLocation>claw</labelNoLocation>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>15</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>FrontRightClaws</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <race>
      <body>QuadrupedAnimalWithClawsTailAndJowl</body>
      <predator>true</predator>
      <maxPreyBodySize>2.0</maxPreyBodySize>
      <baseBodySize>3.0</baseBodySize>
      <baseHealthScale>3.0</baseHealthScale>
      <baseHungerRate>0.45</baseHungerRate>
      <foodType>CarnivoreAnimal</foodType>
      <canFishForFood>true</canFishForFood>
      <leatherDef>Leather_Lizard</leatherDef>
      <waterSeeker>true</waterSeeker>
      <waterCellCost>1</waterCellCost>
      <gestationPeriodDays>14</gestationPeriodDays>
      <manhunterOnDamageChance>0.6</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0.4</manhunterOnTameFailChance>
      <lifeExpectancy>60</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBaby</def>
          <minAge>0</minAge>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.1</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.3333</minAge>
        </li>
      </lifeStageAges>
    </race>
  </ThingDef>

