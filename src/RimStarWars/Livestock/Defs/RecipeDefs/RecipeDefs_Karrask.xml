<?xml version="1.0" encoding="utf-8" ?>
<!-- LIVESTOCK_STARTER_TRIO_1 - curing the raw karrask shed into wearable
     plate. Zero new job types or workerClass: this is a plain vanilla
     RecipeDef/RecipeWorker (the same class every bench-craft recipe in
     this repo already uses, e.g. Absorbed_KotorCore_RecipeDefs_Medpacs.xml)
     run as ordinary Bill work at the existing tailoring benches - "very
     easy to work and shape" per the owner's ruling on this row is
     expressed as a below-1.0 WorkToMake stat factor on the cured plate
     itself (ThingDefs_Karrask.xml), not as a cheap recipe; the recipe's
     own workAmount is set to read as "days-long" per the design doc's
     wording, comparable to a mid-tier tailoring job. -->
<Defs>

  <RecipeDef>
    <defName>RSW_CureKarraskPlate</defName>
    <label>cure karrask plate</label>
    <description>Cure a raw karrask shed into durable, workable plate.</description>
    <jobString>Curing karrask plate.</jobString>
    <workAmount>1200</workAmount>
    <effectWorking>Tailor</effectWorking>
    <soundWorking>Recipe_Tailor</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>RSW_KarraskShedRaw</li>
          </thingDefs>
        </filter>
        <count>40</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>RSW_KarraskShedRaw</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <RSW_KarraskPlate>30</RSW_KarraskPlate>
    </products>
    <workSkill>Crafting</workSkill>
    <skillRequirements>
      <li>
        <skill>Crafting</skill>
        <minLevel>3</minLevel>
      </li>
    </skillRequirements>
    <recipeUsers>
      <li>HandTailoringBench</li>
      <li>ElectricTailoringBench</li>
    </recipeUsers>
  </RecipeDef>

</Defs>
