<?xml version="1.0" encoding="utf-8" ?>
<!-- New native content, SONIC_WEAPONS_EXPANSION_1 (not absorbed — RSW_ prefix per
     design/NAMING_SCHEME_PLAN.md). A heavy, two-handed single-target tier ABOVE the
     10 existing pistol/rifle-class sonic weapons (guy762_sonpistol/guy762_sonrifle
     and their 8 variants). Follows the shape of
     Absorbed_KotorWeapons_WeaponRanged_KotORSonicRifle.xml's guy762_sonrifle (same
     ParentName, recipeMaker/costList/weaponTags pattern) — no new C#.

     Fires KotORSonicWave_heavy, an EXISTING absorbed projectile ThingDef
     (Absorbed_KotorCore_Bullets_Base.xml, damageAmountBase 16, armorPenetrationBase
     0.15) that ships in guy762.mm.kotorcore but was orphaned — no weapon in the
     absorbed pack ever fires it. It already carries damageDef
     guy762_RangedDamage_sonic UNCHANGED, so reusing it here needed no new
     projectile def at all, and the 10 existing weapons' own KotORSonicWave_default
     stays untouched. This mod's own doctrine (src/RimStarWars/Armoury/README.md)
     keeps verb weapons — ion/stun/EMP/sonic — at near-zero damage on purpose
     ("the verb IS the weapon"); doubling to 16 (vs the rifle's 8) satisfies the item's
     explicit "higher per-shot damage than the rifle" instruction without turning
     sonic into a kill weapon, since guy762 himself sized this exact number for a
     heavier tier that was never built out.

     Texture reuses guy762_sonrifle_arkanian's own sprite (kotorsonrifle_arkanian,
     drawSize 2) for a bulkier ground silhouette than the plain rifle at zero new
     art cost — that def is untouched, texPaths are freely shared across ThingDefs
     in RimWorld. Dedicated art is a TODO for FOUNDRY's art pass. -->
<Defs>

  <ThingDef ParentName="KotORRangedMakeable_TwoHand">
    <defName>RSW_Sonic_Cannon</defName>
    <label>sonic cannon</label>
    <description>A heavier descendant of the sonic rifle, built to throw a much larger acoustic charge in a single directed blast. Slow to charge and punishing to carry, it trades rate of fire for a wave that fractures bone and buckles plate alike.</description>
    <descriptionHyperlinks>
      <HediffDef>guy762_SonicDisorient</HediffDef>
    </descriptionHyperlinks>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>kotorsonrifle_arkanian</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>2</drawSize>
    </graphicData>
    <equippedAngleOffset>35</equippedAngleOffset>
    <soundInteract>kotorsound_select_carbine</soundInteract>
    <statBases>
      <MarketValue>2600</MarketValue>
      <Mass>10</Mass>
      <AccuracyTouch>0.30</AccuracyTouch>
      <AccuracyShort>0.55</AccuracyShort>
      <AccuracyMedium>0.75</AccuracyMedium>
      <AccuracyLong>0.65</AccuracyLong>
      <RangedWeapon_Cooldown>4</RangedWeapon_Cooldown>
      <RangedWeapon_DamageMultiplier>1.3</RangedWeapon_DamageMultiplier>
      <WorkToMake>60000</WorkToMake>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>-0.15</MoveSpeed>
    </equippedStatOffsets>
    <recipeMaker>
      <researchPrerequisite>guy762_ResearchKotOR_sonic</researchPrerequisite>
      <skillRequirements>
        <Crafting>10</Crafting>
      </skillRequirements>
    </recipeMaker>
    <costList>
      <Plasteel>140</Plasteel>
      <ComponentIndustrial>10</ComponentIndustrial>
      <ComponentSpacer>7</ComponentSpacer>
    </costList>
    <weaponTags>
      <li>SpacerGun</li>
      <li>KotORRanged_sonic</li>
      <li>KotORRanged_strong</li>
      <li>SWKotORWeaponCategoryTag_heavyranged</li>
    </weaponTags>
    <tradeTags>
      <li>guy762TT_KotORGeneric_adv</li>
      <li>guy762TT_KotORGeneric_exotic</li>
      <li>guy762TT_KotORRanged</li>
    </tradeTags>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>KotORSonicWave_heavy</defaultProjectile>
        <warmupTime>3.5</warmupTime>
        <range>30</range>
        <ticksBetweenBurstShots>40</ticksBetweenBurstShots>
        <burstShotCount>2</burstShotCount>
        <soundCast>kotorsound_bowcaster1</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
        <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>12</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <thingSetMakerTags>
      <li>RewardStandardLowFreq</li>
    </thingSetMakerTags>
  </ThingDef>

</Defs>
