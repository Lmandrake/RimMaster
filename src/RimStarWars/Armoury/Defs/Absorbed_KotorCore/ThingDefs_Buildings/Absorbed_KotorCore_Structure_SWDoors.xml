  <ThingDef ParentName="guy762_DoubleAutoDoorBase">
    <defName>guy762_DoubleAutodoor_Vjun</defName>
    <label>bulky double autodoor</label>
    <description>Divides rooms. Powered operation allows people to move through the door without slowing down.</description>
    <graphicData>
      <texPath>Buildings/Doors/VjunDoorDouble</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <color>(175,175,170)</color>
      <!-- <colorTwo>(65,65,80)</colorTwo> -->
    </graphicData>
    <uiIconPath>Buildings/Doors/VjunDoorDouble_icon_south</uiIconPath>
    <statBases>
      <MaxHitPoints>800</MaxHitPoints>
      <DoorOpenSpeed>0.3</DoorOpenSpeed>
    </statBases>
    <building>
      <isAirtight>true</isAirtight>
      <soundDoorOpenPowered>kotorsound_building_ClassicJKDoor</soundDoorOpenPowered>
      <soundDoorClosePowered>kotorsound_building_DoorClose</soundDoorClosePowered>
      <isSupportDoor>true</isSupportDoor>
      <doorTopGraphic>
        <texPath>Buildings/Doors/DoubleDoorFrame_Square</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <shaderType>CutoutComplex</shaderType>
        <drawSize>(2.5, 1.5)</drawSize>
      </doorTopGraphic>
      <blueprintGraphicData>
        <texPath>Buildings/Doors/VjunDoorDouble_icon_south</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <shaderType>EdgeDetect</shaderType>
        <drawSize>(2.5, 1.5)</drawSize>
      </blueprintGraphicData>
    </building>
    <costList>
      <Steel>135</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
  </ThingDef>

