<!--
  Absorbed from badoaks.meatonastick (workshop 3435027361) and
  badoaks.meatonastick.expansion (workshop 3577333297) per STICK_FOOD_INGEST_1,
  owner ruling 2026-09-02: "Ingest the stuff on a stick mod into our own
  version and jettison that mod eventually... Let's take what we need and
  release them." Both donor mods stay ACTIVE until retirement is executed
  separately (this item's own ## verify still owes that step).

  Moved here from the standalone src/RimUtinni/StickCuisine/ mod, owner
  ruling 2026-09-05: Star Wars cuisine content belongs in one shared
  galaxy-general mod (mandrake.rsw.cuisine), not a separate RimUtinni mod
  per campaign. RUT_ defNames renamed to RSW_ in this move.

  Parents (MealCookedIngredientless, ResourceBase, CookMealBase) are real
  vanilla Core defs (Data/Core/Defs/ThingDefs_Items/Items_Food.xml),
  confirmed on disk before use - not guessed.
-->
<Defs>

  <ThingDef ParentName="ResourceBase">
    <defName>RSW_Skewer</defName>
    <label>skewer</label>
    <description>A pointy stick made from wood. It can be used to skewer and cook food at a campfire.</description>
    <graphicData>
      <texPath>Items/RSW_Skewer/RSW_Skewer</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <tradeability>None</tradeability>
    <statBases>
      <MarketValue>0.12</MarketValue>
      <Mass>0.0008</Mass>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
  </ThingDef>

