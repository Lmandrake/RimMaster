<?xml version="1.0" encoding="utf-8"?>
<!--
  Absorbed from badoaks.meatonastick + badoaks.meatonastick.expansion per
  STICK_FOOD_INGEST_1. CookMealBase is a real vanilla Core RecipeDef,
  confirmed on disk before use.

  IngredientValueGetter_ExcludeSkewer replaces the donor expansion's
  un-sourced MOAS_Expansion.IngredientValueGetter_MeatlessStick - see that
  C# file's header for why it's a reconstruction, not a byte-for-byte port.

  Moved here from the standalone src/RimUtinni/StickCuisine/ mod, owner
  ruling 2026-09-05 - see ThingDefs_Cuisine.xml's header for why.
-->
<Defs>

  <!-- Base: meat only, no skewer resource required -->
  <RecipeDef ParentName="CookMealBase">
    <defName>RSW_CookMeatOnAStick</defName>
    <label>cook meat on a stick</label>
    <description>Cook raw meat over an open fire.</description>
    <jobString>Cooking meat on a stick.</jobString>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>MeatRaw</li>
          </categories>
        </filter>
        <count>0.5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <disallowedCategories>
        <li>PlantFoodRaw</li>
        <li>AnimalProductRaw</li>
      </disallowedCategories>
    </fixedIngredientFilter>
    <products>
      <RSW_MeatOnAStick>1</RSW_MeatOnAStick>
    </products>
    <workSkill>Cooking</workSkill>
    <displayPriority>95</displayPriority>
    <recipeUsers>
      <li>Campfire</li>
    </recipeUsers>
  </RecipeDef>

