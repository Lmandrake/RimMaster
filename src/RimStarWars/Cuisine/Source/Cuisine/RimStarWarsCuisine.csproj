<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RimWorld 1.6 runs Unity/Mono against a .NET Framework 4.7.2 profile, so
    the mod DLL must target net472. Same shape as
    src/RimStarWars/Livestock/Source/RimMandrakeLivestockRSW.csproj.

    Build (dotnet is WINDOWS-NATIVE, cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimStarWars\Cuisine\Source\Cuisine\RimStarWarsCuisine.csproj -c Release

    Output lands in ../../Assemblies/, which is where RimWorld looks.

    Moved here from src/RimUtinni/StickCuisine/ (owner ruling 2026-09-05):
    Star Wars cuisine content belongs in one shared galaxy-general mod, not
    a separate RimUtinni mod per campaign. STICK_FOOD_INGEST_1's two small
    hooks: NameGenComp (ported verbatim from badoaks.meatonastick's own
    shipped Source), IngredientValueGetter_ExcludeSkewer (FOUNDRY's own
    reconstruction of the donor expansion's un-sourced
    MOAS_Expansion.IngredientValueGetter_MeatlessStick - see that file's header).
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimStarWarsCuisine</AssemblyName>
    <RootNamespace>RimMandrake.StarWars.Cuisine</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="CuisineDefOf.cs" />
    <Compile Include="NameGenComp.cs" />
    <Compile Include="IngredientValueGetter_ExcludeSkewer.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
