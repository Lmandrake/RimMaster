<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ========================================================================
       RSW_DW_Power — the droid power need. Backs Droidworks.Need_Power
       (Source/Droidworks/Need_Power.cs). Falls at the race's
       DroidworksExtension.powerFallPerDay; at 0.02 the C# applies RSW_DW_PoweredDown
       via NeedInterval (state 3 — see HediffDefs_Droidworks.xml). Fields match a
       vanilla NeedDef shape 1:1 (RimWorld's own Chemical_* needs), not guessed.
  ======================================================================== -->
  <NeedDef>
    <defName>RSW_DW_Power</defName>
    <needClass>Droidworks.Need_Power</needClass>
    <label>power</label>
    <description>Stored charge. A droid whose power runs out shuts down until someone reboots it.</description>
    <showOnNeedList>true</showOnNeedList>
    <major>false</major>
  </NeedDef>

</Defs>
