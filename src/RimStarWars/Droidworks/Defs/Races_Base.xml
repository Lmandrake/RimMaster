<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Droidworks race base. Concrete races descend through the family layer
       (Races_Families.xml's DW_Family_* abstracts) onto this one, not
       directly — see that file for why. ParentName="Human" gives a working
       race.body, needs and apparel slots for free — matches the pattern used
       by other private HAR races that don't want a bespoke BodyDef (e.g.
       XMT_Starbeast_AlienRace, workshop 3596077324: ParentName="Human",
       Class="AlienRace.ThingDef_AlienRace", no thingClass override, no
       custom BodyDef). Concrete races override defName/label/description/
       race/alienRace/graphicPaths/generalSettings/modExtensions.

       Food and Rest: `Pawn_NeedsTracker.ShouldHaveNeed` special-cases
       exactly two needs — `nd == NeedDefOf.Food -> pawn.RaceProps.EatsFood`
       (driven by `<foodType>`) and `nd == NeedDefOf.Rest ->
       pawn.RaceProps.needsRest`. Every other need
       (Mood/Joy/Beauty/Comfort/Expectations/...) falls through to `true`
       unless a hediff/gene/trait/ideo explicitly disables it. DELIBERATELY
       NOT touched here: this base keeps `intelligence` Humanlike (inherited
       from ParentName="Human") specifically so the "soul" layer (drift,
       module personality, long-unwiped droids are PEOPLE —
       droid_system_build_spec.md Phase 3) has real Mood/Joy to work with.
       Stripping those needs would be a bigger design call than this file's
       scope — flagged for the owner, not decided here. Xenotype/genes are a
       SEPARATE mechanism (`PawnKindDef.xenotypeSet`, not a race field —
       `PawnGenerator.cs` reads it, `RaceProperties` has no such field) and
       are fixed per-kind by the generator, not here.

       `<fleshType>RSW_DW_FleshType_Droid</fleshType>` makes every droid
       Humanlike-intelligence AND non-flesh, a combination vanilla's own
       `PawnComponentsUtility.CreateInitialComponents` leaves with a null
       `pawn.relations` (it only allocates one `if (pawn.RaceProps.IsFlesh)`,
       and Humanlike pawn generation assumes every Humanlike has one).
       RimMandrake.StarWars.Droidworks' own Harmony bootstrap
       (Patch_ShouldHaveNeed_Power.cs / DroidworksNeedGateMod) carries a
       postfix on that same method closing the gap, idempotent against
       RimUtinni.Doctrine's identical fix for the already-shipped
       OuterRim/KotOR droids should both mods be active together. -->
  <!-- Wires the four Droidworks recipes (RSW_DW_RebootDroid,
       RSW_DW_InstallRestrainingBolt, RSW_DW_RemoveRestrainingBolt,
       RSW_DW_MemoryWipe) onto every droid race in one place; the RecipeDefs
       themselves leave `recipeUsers` unset. No `Inherit="False"` — Human
       itself declares 22 `<recipes>` (RemoveBodyPart, Euthanize, Anesthetize
       and 19 DLC-gated others), and RimWorld's list inheritance appends
       rather than replaces, so droids correctly keep those alongside the
       four Droidworks-specific ones rather than losing them. -->
  <AlienRace.ThingDef_AlienRace Name="DW_Race_Base" ParentName="Human" Abstract="True">
    <race>
      <body>Human</body>
      <foodType>None</foodType>
      <needsRest>false</needsRest>
      <fleshType>RSW_DW_FleshType_Droid</fleshType>
    </race>
    <recipes>
      <li>RSW_DW_RebootDroid</li>
      <li>RSW_DW_InstallRestrainingBolt</li>
      <li>RSW_DW_RemoveRestrainingBolt</li>
      <li>RSW_DW_MemoryWipe</li>
    </recipes>
    <alienRace>
      <generalSettings>
        <alienPartGenerator>
          <headTypes Inherit="False">
            <li>Male_AverageNormal</li>
          </headTypes>
          <bodyTypes Inherit="False">
            <li>Male</li>
          </bodyTypes>
        </alienPartGenerator>
      </generalSettings>
      <graphicPaths>
        <skinShader>Cutout</skinShader>
      </graphicPaths>
    </alienRace>
  </AlienRace.ThingDef_AlienRace>

  <!-- Our own droid flesh type, isOrganic:false from birth
       (droid_system_build_spec.md §1). Wired onto DW_Race_Base above.
       Mirrors vanilla `Mechanoid`'s other
       fields (corpseCategory, damageEffecter, genericWounds — reusing
       vanilla's own mech wound textures, no new art needed) so droids hit
       and rot like machines everywhere that checks fleshType rather than
       IsMechanoid specifically. Does NOT set IsMechanoid=true (that stays a
       property of FleshTypeDefOf.Mechanoid alone) — keeping IsMechanoid
       false is the whole point (droid_ruling.md, JawaIonWeapons' own guard
       comment): these are non-mechanoid humanlikes, force-kill-on-down does
       not apply, and the ion capture pipeline treats them as capturable. -->
  <FleshTypeDef>
    <defName>RSW_DW_FleshType_Droid</defName>
    <corpseCategory>CorpsesMechanoid</corpseCategory>
    <damageEffecter>Damage_HitMechanoid</damageEffecter>
    <genericWounds>
      <li>
        <texture>Things/Pawn/Wounds/WoundMechA</texture>
      </li>
      <li>
        <texture>Things/Pawn/Wounds/WoundMechB</texture>
      </li>
      <li>
        <texture>Things/Pawn/Wounds/WoundMechC</texture>
      </li>
    </genericWounds>
    <isOrganic>false</isOrganic>
  </FleshTypeDef>

  <!-- Shared blank head — for source droids whose own art has no separate
       head layer (the KotOR/OuterRim "NNNblank"/no-Head-folder convention,
       carried forward honestly here rather than letting a headless droid
       inherit DW_Race_Base's Male_AverageNormal human face). DW/blank_*.png
       is a generated fully-transparent stub written once by the generator
       if missing — a technical rendering stub, not hand-drawn art. -->
  <HeadTypeDef>
    <defName>RSW_DW_HeadType_Blank</defName>
    <graphicPath>DW/blank</graphicPath>
    <gender>None</gender>
  </HeadTypeDef>

</Defs>
