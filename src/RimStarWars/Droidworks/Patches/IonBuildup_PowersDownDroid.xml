<?xml version="1.0" encoding="utf-8"?>
<!--
  DROIDWORKS_POWEREDDOWN_NOT_WIRED_1. Wires HediffComp_IonOverloadsDroid
  (Source/Droidworks/HediffComp_IonOverloadsDroid.cs) onto JawaIonWeapons'
  RSW_JawaIon_Stun so a DW_ race droid crossing the ion-overload threshold gets
  the persistent RSW_DW_PoweredDown state instead of a self-decaying stun. See
  that C# file's own header for the full mechanism. FindMod-gated: a no-op
  if Jawa Ion Weapons isn't active, matching the "patch matches nothing,
  nothing happens" doctrine deliberately here.
-->
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Jawa Ion Weapons (local)</li>
    </mods>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/HediffDef[defName="RSW_JawaIon_Stun"]/comps</xpath>
      <value>
        <li Class="RimMandrake.StarWars.Droidworks.HediffCompProperties_IonOverloadsDroid" />
      </value>
    </match>
  </Operation>
</Patch>
