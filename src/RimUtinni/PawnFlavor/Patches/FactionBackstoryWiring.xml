    <xpath>/Defs/FactionDef[defName="Jawa_WildsteamClan"]/backstoryFilters</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/FactionDef[defName="Jawa_WildsteamClan"]</xpath>
