  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/FactionDef[defName="Jawa_Junkers"]/backstoryFilters</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/FactionDef[defName="Jawa_Junkers"]</xpath>
      <value>
        <backstoryFilters>
          <li>
            <categories>
              <li>Pirate</li>
            </categories>
