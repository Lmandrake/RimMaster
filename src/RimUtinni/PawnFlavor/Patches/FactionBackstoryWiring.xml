      <xpath>/Defs/FactionDef[defName="Jawa_GeonosianFoundryHive"]</xpath>
      <value>
        <backstoryFilters>
        <li>
          <categories>
            <li>Outlander</li>
          </categories>
        </li>
        <li>
          <categories>
            <li>Offworld</li>
          </categories>
        </li>
        <li>
          <categories>
            <li>JawaBSC_Geonosian</li>
          </categories>
        </li>
      </backstoryFilters>
      </value>
    </nomatch>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/FactionDef[defName="Jawa_AscendantHelix"]/backstoryFilters</xpath>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/FactionDef[defName="Jawa_AscendantHelix"]</xpath>
      <value>
        <backstoryFilters>
        <li>
          <categories>
            <li>Outlander</li>
          </categories>
        </li>
        <li>
