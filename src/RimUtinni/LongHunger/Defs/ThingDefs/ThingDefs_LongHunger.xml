<?xml version="1.0" encoding="utf-8" ?>
<!--
  SANDWORM_MYTHOS_BUILD_1 - the Long Hunger, Ash'karr's dune-dwelling VAST
  leviathan. Krayt Dragon (mlie.starwarsanimalcollection) stays exactly as-is
  per the owner's ruling; this is a wholly separate creature/mythos.

  Shape: no <race> on RUT_LongHunger - a Building-class world entity, per
  design/Jawa/worldbuilding/setting_physics.md Part 5's ruled VAST template
  (chezhou.creature.sandworm, LEVIATHANS:SANDWORM, is the reference; its own
  ChezhouLib C# is closed/Workshop-only and NOT used here - this is original
  code, see Source/LongHungerThing.cs and IncidentWorker_LongHungerSurfaces.cs).

  Territory: the `Dunes` tile mutator (ExtremeDesert + Flat, 1,083 tiles, 5.0%
  of the planet - ASHKARR_WORLD_DEFINITION.md SS13.1) already strips those tiles
  of ruins/junk/plants/geysers. The Long Hunger is this item's in-fiction reason
  why: nothing survives there to leave anything behind.

  Texture reuse: RUT_LongHunger borrows Anomaly's PitGate texture
  (Things/Building/PitGate/PitGate) - the closest official precedent for "a
  terrain feature that erupts with a threat," and Anomaly is part of this
  campaign's confirmed full-expansion stack (rimworld-load-round SKILL.md).
  RUT_Groundcaller gets its own simple placeholder texture note below (v1 art
  gap, named not hidden - see the item file).
-->
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>RUT_Groundcaller</defName>
    <label>groundcaller</label>
    <description>A resonant drum built from scavenged parts. Struck automatically once primed, it mimics the low seismic call deep-desert lore says draws the Long Hunger to the surface. Deep Desert tribes will not go near ground that has ever held one.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <drawerType>RealtimeOnly</drawerType>
    <tickerType>Never</tickerType>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <passability>Impassable</passability>
    <fillPercent>0.6</fillPercent>
    <graphicData>
      <!-- v1 art gap, named honestly: reuses vanilla's own mini-turret gun
           silhouette as a stand-in until a real sprite is authored
           (generating-rimworld-sprites skill). Path confirmed real by
           reading Buildings_Security_Turrets.xml directly (Turret_Mortar's
           OWN texPath, first guessed here, turned out to be inherited and
           not a literal path - caught by validate_patch.py's texPath check,
           not assumed clean). -->
      <texPath>Things/Building/Security/TurretMini_Top</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.5,1.5)</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <Mass>6</Mass>
      <WorkToBuild>800</WorkToBuild>
    </statBases>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <minifiedDef>MinifiedThing</minifiedDef>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>RUT_LongHunger</defName>
    <label>the Long Hunger</label>
    <description>The ground here is not empty by chance. Something vast lives beneath the dunes, drawn by vibration and gone again within the hour - and it has been swallowing whatever the desert offers it for longer than any settlement's records go back.</description>
    <thingClass>LongHunger.LongHungerThing</thingClass>
    <category>Building</category>
    <tickerType>Normal</tickerType>
    <useHitPoints>true</useHitPoints>
    <selectable>true</selectable>
    <altitudeLayer>Pawn</altitudeLayer>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <passability>PassThroughOnly</passability>
    <graphicData>
      <texPath>Things/Building/PitGate/PitGate</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(6,6)</drawSize>
    </graphicData>
    <uiIconPath>Things/Building/PitGate/PitGate</uiIconPath>
    <statBases>
      <MaxHitPoints>2000</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
  </ThingDef>

</Defs>
