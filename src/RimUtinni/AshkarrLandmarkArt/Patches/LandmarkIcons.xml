<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Point each LandmarkDef at our repainted icon.
       Wrapped in PatchOperationConditional because these defs come from four different
       mods and any of them may be inactive: a Conditional whose xpath matches nothing
       returns true and logs nothing, where a bare Replace would log an error per def.
       The inner Conditional matters too - defs like AncientGarrison INHERIT
       iconTexturePath from an abstract parent and have no node of their own to replace,
       so those take the Add branch. -->

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/LandmarkDef[defName="AB_MagmaticQuagmire"]</xpath>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/LandmarkDef[defName="AB_MagmaticQuagmire"]/iconTexturePath</xpath>
      <match Class="PatchOperationReplace">
        <xpath>/Defs/LandmarkDef[defName="AB_MagmaticQuagmire"]/iconTexturePath</xpath>
        <value><iconTexturePath>World/Landmarks/Ashkarr/AB_MagmaticQuagmire</iconTexturePath></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/LandmarkDef[defName="AB_MagmaticQuagmire"]</xpath>
        <value><iconTexturePath>World/Landmarks/Ashkarr/AB_MagmaticQuagmire</iconTexturePath></value>
      </nomatch>
    </match>
  </Operation>

