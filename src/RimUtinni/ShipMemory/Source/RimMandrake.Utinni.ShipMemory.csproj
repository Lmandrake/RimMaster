<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ANOMALY_EXCEPTION_ACCESS_1: the Memory-Core revelation. One GameComponent,
    no Harmony (discoveryPrerequisites + HiddenItemsManager are stock vanilla
    APIs; design/Jawa/anomaly_exception_access_spec.md §1 "why this and not
    the alternatives"). Mirrors src/RimUtinni/EmpirePursuit/Source/EmpirePursuit.csproj
    (net472, OutputPath ..\Assemblies\) minus the Harmony reference this mod
    does not need.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimUtinni\ShipMemory\Source\RimMandrake.Utinni.ShipMemory.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrake.Utinni.ShipMemory</AssemblyName>
    <RootNamespace>RimMandrake.Utinni.ShipMemory</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="GameComponent_ShipMemory.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
