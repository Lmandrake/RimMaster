<?xml version="1.0" encoding="utf-8"?>
<!-- SUPPLEMENT to the generated RUT_ResearchRetag.xml - written by hand 2026-09-04
     because build_retag_patches.py diffs the manifest against the LIVE capture, and
     the live capture is now POST-RETAG: regenerating erases the 269 ops whose targets
     already read correct (defect filed: RETAG_BUILDER_SELF_ERASE_1). These 13 rows
     (10 revived DP_RGive + 3 RUT_Antiq) were unmeasurable in the pre-retag capture
     and are patched here per the manifest tier grammar. Fold into the generator when
     the defect is fixed; techLevel targets come from the manifest tier column. -->
<Patch>
