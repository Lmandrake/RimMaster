<Patch>

  <!-- ===================== kotorcore-side (sites 2, 3, 4, 5, 6) ===================== -->
  <!-- All gated on ABF's ABSENCE (nomatch) - dormant while ABF is active and these
       mechanics are real, fires only once ABF actually retires. -->

  <!-- Site 2: guy762_DroidPawnKindBase's ABF_ArtificialPawnKindExtension
       (also reaches guy762.KotORDroids' own duplicate copy - see NEW FINDING above) -->
  <Operation Class="PatchOperationFindMod">
    <mods><li>ABF: Artificial Beings Framework</li></mods>
    <nomatch Class="PatchOperationRemove">
      <xpath>/Defs/PawnKindDef[@Name="guy762_DroidPawnKindBase"]/modExtensions/li[@Class="ArtificialBeings.ABF_ArtificialPawnKindExtension"]</xpath>
    </nomatch>
  </Operation>

  <!-- Site 3: KotORDroidBase_good's ABF_ArtificialPawnKindExtension (live Name, not the item doc's stale guess) -->
  <Operation Class="PatchOperationFindMod">
    <mods><li>ABF: Artificial Beings Framework</li></mods>
    <nomatch Class="PatchOperationRemove">
      <xpath>/Defs/PawnKindDef[@Name="KotORDroidBase_good"]/modExtensions/li[@Class="ArtificialBeings.ABF_ArtificialPawnKindExtension"]</xpath>
    </nomatch>
  </Operation>

  <!-- Site 4: SWCPDroidBase_bad's ABF_ArtificialPawnKindExtension -->
  <Operation Class="PatchOperationFindMod">
