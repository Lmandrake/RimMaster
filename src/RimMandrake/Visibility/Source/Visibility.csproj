<Project Sdk="Microsoft.NET.Sdk">

  <!--
    COLONY_VISIBILITY_BUILD_1. Harmony (0Harmony.dll) dependency for the
    threat-point patch, so net48 + its own reference, same pattern as
    src/RimUtinni/Doctrine/Source/DoctrineCore/JawaDoctrineCore.csproj.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimMandrake\Visibility\Source\Visibility.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.

    Every reference is Private=false. Nothing but our own DLL may land next
    to the mod: shipping a copy of Assembly-CSharp.dll or 0Harmony.dll would
    give the game two of each, and Harmony in particular must come from
    brrainz.harmony.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrakeVisibility</AssemblyName>
    <RootNamespace>RimMandrake.Visibility</RootNamespace>
    <Version>0.1.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <!-- FOUNDRY, 2026-09-07: EnableDefaultCompileItems=false plus a hand-maintained
         Compile Include list silently dropped DebugActions_Visibility.cs,
         the exact trap Ninefold's own csproj comment documents (10 Patch_*.cs
         files silently excluded there). Switched to the default SDK glob
         (compiles every *.cs here EXCEPT SelfTest/, its own separate project;
         see the Compile Remove below) so a new file is never silently
         omitted again; a build with 0 warnings/0 errors is meaningless if the
         compiler was never even told the file exists. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HarmonyDll)' == ''">
    <HarmonyDll>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <ItemGroup>
    <!-- SelfTest/ is its own project (RimMandrakeVisibility.SelfTest.csproj);
         the default glob is recursive, so it must be excluded here or its
         Program.cs (and any Main entry point) would compile twice. -->
    <Compile Remove="SelfTest/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
