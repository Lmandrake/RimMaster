<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================
       Sacred graffiti — devotional wall-marks, one per Salvation god.

       ParentName reaches across mods into mandrake.rm.graffiti's own
       RM_BaseGraffiti (repointed 2026-08-31 from Mlie.GraffitiMod's
       BaseGraffiti now that mod is retired, GRAFFITI_FRAMEWORK_BUILD_1 —
       thingClass plain vanilla Filth, verified CornerFiller linking needs
       no special subclass) for the filth/building field set an ordinary
       wall-mark needs: filth placement+cleaning, building.canPlaceOverWall,
       zero flammability. Requires
       mandrake.rm.graffiti loaded first (About.xml loadAfter/modDependencies).

       Unlike GraffitiMod_Paint (the mod's one hardcoded, always-ugly
       filth def), each mark here carries its OWN statBases so a devotional
       mark can read as beautiful (positive Beauty) rather than vandalism -
       the same statBases field GraffitiMod already uses, just given a
       different sign per god's canon nature.

       Iconography source (LOCKED, do not invent new imagery):
       design/Jawa/divine_satiation_engine.md, "The Pantheon — canon of
       record", each god's "Form:" line.

       Placement mechanism (owner's ruling, GRAFFITI_MOD_EXPANSION_1): a
       ritual outcome, not a Harmony patch on GraffitiMod's own hardcoded
       spawn loop (which cannot reach these defNames at all — see About.xml)
       and not hand-placement. RitualOutcomeEffectWorker_PlaceSacredMark
       (Source/SacredGraffiti.cs, wired via Defs/RitualOutcomeEffects.xml) is
       the reusable mechanism, ready the moment a real Salvation Matrix
       ritual exists to invoke it — none do yet; the Matrix is design prose
       only (design/Jawa/divine_satiation_engine.md, "The Matrix" section).
       Until a real ritual references it, these marks are valid, inert
       content — spawnable only via dev-mode "spawn thing" for inspection.
       ============================================================ -->

  <ThingDef ParentName="RM_BaseGraffiti">
    <defName>RM_SacredMark_Ishko</defName>
    <label>sacred mark of Ishko</label>
    <description>A pair of glowing orange eyes daubed on the wall in ochre and rust pigment, radiating short watchful strokes into the dark around them. Ishko the Unmaskable's mark - painted by a hand that believes stillness is holy, in the one god who does not punish a skipped rite, because to remain hidden and unlooked-at is, to him, already righteous.</description>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Filth/SacredMark/SacredMark_Ishko</texPath>
    </graphicData>
    <statBases>
      <Flammability>0</Flammability>
      <Beauty>6</Beauty>
      <Cleanliness>-2</Cleanliness>
    </statBases>
    <!-- GRAFFITI_FRAMEWORK_BUILD_1: wire this already-shipped mark into
         mandrake.rm.graffiti's engine now that the data layer exists.
         category=Sacred, supportsQuality=false (fixed single-quality per
         spec §1/§3 - "the marks ARE the livery, painted", no quality roll),
         hasSubject=false (no named colonist), godSatiationHook="Ishko"
         matches RimMandrake.Ninefold.God's own enum member name (Source/
         God.cs) - the string a future Ninefold-aware bridge reads to call
         GameComponent_Ninefold.ApplyDelta. viewerReactionThought left unset:
         no content ThoughtDef exists yet (owner-voice work, tracked in the
         item file) - ThoughtWorker_ViewedGraffitiMark simply finds nothing
         to match until one does. -->
    <modExtensions>
      <li Class="RimMandrake.Graffiti.ModExtension_Graffiti">
        <category>Sacred</category>
        <supportsQuality>false</supportsQuality>
        <hasSubject>false</hasSubject>
        <godSatiationHook>Ishko</godSatiationHook>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
