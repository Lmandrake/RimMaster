<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ORACLE_EXPERIMENT_SPIKE_1: thin OpenAI-compatible client plus ONE god-letter
    consumer (Ohm), end to end. See design/RimMandrake/llm_ingame_wiring_spec.md.
    The Oracle is the Narrator's engine, not any god's (owner 2026-08-30): Ohm is
    the first of nine consumers, not the ship and not the Oracle.
    No Harmony: nothing here patches anything, it is pure new behavior behind
    two debug actions and a GameComponent queue.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimMandrake\Oracle\Source\Oracle.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrakeOracle</AssemblyName>
    <RootNamespace>RimMandrake.Oracle</RootNamespace>
    <Version>0.1.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      System.Net.Http.dll DOES ship in RimWorld's own Managed/ folder (Unity's
      trimmed Mono BCL includes it): confirmed by directory listing, not
      assumed. Referenced from RimWorldManaged like the game's own assemblies
      above, not from the NuGet reference-assemblies package, so what we
      compile against is what will actually be present at runtime.
    -->
    <Reference Include="System.Net.Http">
      <HintPath>$(RimWorldManaged)\System.Net.Http.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
