<!--
  A goodwill change needs a reason, and the reason is a HistoryEventDef - it is
  what the faction tab shows the player next to the number. Core keeps its own in
  Data\Core\Defs\Goodwill\GoodwillEvents_Quests.xml (QuestPawnLost, QuestPrisonerRecruited,
  MonumentDestroyed, ...); ours is the same shape, one label, nothing else.
-->
<Defs>

  <HistoryEventDef>
    <defName>RM_StrandedTravellerTaken</defName>
    <label>took in a survivor we vouched for</label>
  </HistoryEventDef>

</Defs>
