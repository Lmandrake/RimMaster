<Project Sdk="Microsoft.NET.Sdk">

  <!--
    GRAFFITI_FRAMEWORK_BUILD_1: ModExtension_Graffiti + GraffitiCategory
    (data layer), the absorbed spree JobDriver/JoyGiver, the viewer
    ThoughtWorker (ThoughtWorker_ViewedGraffitiMark - generic, reads
    ModExtension_Graffiti.viewerReactionThought, no content ThoughtDef
    shipped here), and the taunt raid-AI breach-bias hook (BreachBiasHook -
    Harmony postfix on Verse.AI.BreachingGrid.FindBuildingToBreach, reads
    ModExtension_Graffiti.breachLure). Content (sacred/mural/jest/taunt/cant
    text and defs) is a separate item - see GRAFFITI_FRAMEWORK_BUILD_1.md.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimMandrake\Graffiti\Source\Graffiti.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrakeGraffiti</AssemblyName>
    <RootNamespace>RimMandrake.Graffiti</RootNamespace>
    <Version>0.1.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HarmonyDll)' == ''">
    <HarmonyDll>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="GraffitiCategory.cs" />
    <Compile Include="ModExtension_Graffiti.cs" />
    <Compile Include="RMGraffitiDefOf.cs" />
    <Compile Include="GraffitiJobUtility.cs" />
    <Compile Include="JobDriver_PaintGraffiti.cs" />
    <Compile Include="JoyGiver_PaintGraffiti.cs" />
    <Compile Include="MentalState_GraffitiSpree.cs" />
    <Compile Include="JobGiver_GraffitiPaintingSpree.cs" />
    <Compile Include="ThoughtWorker_ViewedGraffitiMark.cs" />
    <Compile Include="BreachBiasHook.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
