<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline, no-game selftest harness for RosterPruning (PLOT_MECHANISM_MODS_WAVE_1's
    OldFriends roster cap/prune rule). Same shape as RimMandrakeProperty.SelfTest.csproj:
    compiles the REAL production RosterPruning.cs/OldFriendEntry.cs/Encounter.cs/
    RoleTag.cs directly, using OldFriendEntry instances with a null Pawn (see
    Program.cs's own header for why that is a valid state for this test).

    Targets net472 with Private=true RimWorldManaged references (like Property's
    own SelfTest) because OldFriendEntry/Encounter are typed against Verse.Pawn/
    RimWorld.Faction/Verse.IExposable, even though nothing called here needs a
    running game.

    NOT the mod build (RM_RaidRedesigner.csproj, one directory up).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrakeRaidRedesigner.SelfTest</AssemblyName>
    <RootNamespace>RimMandrake.RaidRedesigner.SelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DebugType>none</DebugType>
    <BaseOutputPath>bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- The REAL production source files, compiled in directly. -->
    <Compile Include="..\RoleTag.cs" />
    <Compile Include="..\Encounter.cs" />
    <Compile Include="..\OldFriendEntry.cs" />
    <Compile Include="..\RosterPruning.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
