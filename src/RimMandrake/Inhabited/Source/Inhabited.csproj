<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Inhabited - places on the world map have a persistent cast of real pawns.

    RimWorld 1.6 runs Unity/Mono against a .NET Framework 4.7.2 profile, so the
    mod DLL must target net472. There is no Visual Studio or targeting pack on
    this machine, so Microsoft.NETFramework.ReferenceAssemblies supplies the
    reference assemblies from NuGet instead.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\Jawa\Inhabited\Source\Inhabited.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.

    Nothing but our own DLL may land next to the mod. Three mods in this load
    set shipped the base game's assemblies into their Assemblies folder and it
    caused silent chaos; Harmony in particular must come from brrainz.harmony
    at runtime, never from us.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Inhabited</AssemblyName>
    <RootNamespace>Inhabited</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HarmonyDll)' == ''">
    <HarmonyDll>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- DISTRICT_TEMPLATE_LIBRARY_1: GenStep_ComposeSettlementDistrict calls
         into StructureInjections' RimplacePlan.Parse / GenStep_RimplacePlan.ApplyPlan
         rather than reinventing plan-to-map replay. mandrake.rm.injections must
         load before mandrake.rm.inhabited (see About.xml modDependencies/loadAfter) -->
    <Reference Include="RimMandrakeStructureInjections">
      <HintPath>..\..\StructureInjections\Assemblies\RimMandrakeStructureInjections.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
