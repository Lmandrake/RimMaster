<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--
    SETTLEMENT_VISIT_LOOP_1's map generator.

    genSteps is copied wholesale from the shipped `MapCommonBase` abstract
    MapGeneratorDef (Data/Core/Defs/MapGeneration/CommonMapGenerator.xml) plus
    `Encounter`'s own single addition (`RocksFromGrid_NoMinerals`) tacked on
    the end, and NOT from `Encounter`'s own genSteps node, which itself
    redeclares (and so wholesale-replaces) the inherited list down to just
    that one step. Corrected 2026-09-05 dirty-code-review pass: the original
    comment named `Encounter` as the source, which is the def whose OWN list
    is one line long, not the long list actually reproduced below.

    Def XML inheritance REPLACES a redeclared list node wholesale, it does
    not merge it, so redeclaring <genSteps> under ParentName="MapCommonBase"
    here is the only way to get "MapCommonBase's steps plus ours" without
    either duplicating every vanilla step or losing them.

    Two entries added at the bottom: Inhabited_ComposeSettlementDistrict
    (order 850) and Inhabited_Cast (order 900, the same GenStepDef the
    wilderness Inhabited_Place engine uses, reused unchanged; see
    WorldObject_InhabitedSettlement's class comment for why that is safe).
    List POSITION does not matter: MapGenerator.GenerateMap sorts every
    active step by its own GenStepDef.order before running any of them.
  -->
  <MapGeneratorDef ParentName="MapCommonBase">
    <defName>Inhabited_SettlementMapGenerator</defName>
    <genSteps>
      <li>ElevationFertility</li>
      <li>MutatorPostElevationFertility</li>
      <li>Terrain</li>
      <li>MutatorPostTerrain</li>
      <li>Roads</li>
      <li>RockChunks</li>
      <li>MutatorCriticalStructures</li>
      <li>MutatorNonCriticalStructures</li>
      <li>ScatterRuinsSimple</li>
      <li>SteamGeysers</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ScatterRoadDebris</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ScatterCaveDebris</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">AncientUtilityBuilding</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">MechanoidRemains</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">AncientTurret</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">AncientMechs</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">AncientLandingPad</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">AncientFences</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">AncientPipelineSection</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">AncientJunkClusters</li>
      <li>FindPlayerStartSpot</li>
      <li>ScenParts</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">Pollution</li>
      <li MayRequire="Ludeon.RimWorld.Biotech">AncientPollutionJunk</li>
      <li>Plants</li>
      <li>Snow</li>
      <li>MutatorFinal</li>
      <li>Animals</li>
      <li>Fog</li>
      <li>RocksFromGrid_NoMinerals</li>
      <!-- SETTLEMENT_VISIT_LOOP_1 additions -->
      <li>Inhabited_ComposeSettlementDistrict</li>
      <li>Inhabited_Cast</li>
      <!-- INHABITED_STOCK_ONTO_MAP_AND_FATE_1: order 910, after the cast (900)
           because the cast step is what fills the stock holder. -->
      <li>RM_InhabitedStock</li>
    </genSteps>
  </MapGeneratorDef>

</Defs>
