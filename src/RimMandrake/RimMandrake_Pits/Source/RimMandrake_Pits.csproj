<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RIMMANDRAKE_PITS_BUILD_1 core framework. Same recipe as SacredGraffiti
    (src/RimMandrake/SacredGraffiti/Source/SacredGraffiti.csproj) and JawaRules.
    No Harmony reference: everything here is a normal Thing/ThingComp/JobDriver
    subclass through vanilla extension points, not a patch.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\RimMandrake\RimMandrake_Pits\Source\RimMandrake_Pits.csproj -c Release

    Output lands in ../Assemblies/, which is where RimWorld looks.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RimMandrakePits</AssemblyName>
    <RootNamespace>RimMandrake.Pits</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RimMandrakePits_DefOf.cs" />
    <Compile Include="TerrainMimic\Building_TerrainMimicCover.cs" />
    <Compile Include="Trigger\CompProperties_PitCoverTrigger.cs" />
    <Compile Include="Trigger\CompPitCoverTrigger.cs" />
    <Compile Include="Trigger\PitCoverTier.cs" />
    <Compile Include="DigStage\PitDepthTier.cs" />
    <Compile Include="DigStage\CompProperties_PitDigStage.cs" />
    <Compile Include="DigStage\CompPitDigStage.cs" />
    <Compile Include="DigStage\Building_PitDigSite.cs" />
    <Compile Include="DigStage\WorkGiver_DigPitDeeper.cs" />
    <Compile Include="DigStage\JobDriver_DigPitDeeper.cs" />
    <Compile Include="Fitting\PitFittingType.cs" />
    <Compile Include="Fitting\CompProperties_PitFitting.cs" />
    <Compile Include="Fitting\CompPitFitting.cs" />
    <Compile Include="Escape\PitEscapeUtility.cs" />
    <Compile Include="Holding\Building_OpenPit.cs" />
    <Compile Include="Holding\Building_PitCell.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
