<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ========================================================================
       DW_Recharge — the active half of DROIDWORKS_CHARGING_TRIO_1. Backs
       Droidworks.JobDriver_DWRecharge (Source/Droidworks/JobDriver_DWRecharge.cs):
       a droid walks to a DW_ChargeSocket or DW_ChargeDock and stands at its
       interaction cell while Need_Power rises. Issued both by the player
       (float menu / forced work) and unprompted by
       Droidworks.JobGiver_DWRecharge (see ThinkTreeDefs_DWRecharge.xml).
  ======================================================================== -->
  <JobDef>
    <defName>DW_Recharge</defName>
    <driverClass>Droidworks.JobDriver_DWRecharge</driverClass>
    <reportString>recharging at TargetA.</reportString>
    <suspendable>false</suspendable>
  </JobDef>

  <!-- ========================================================================
       DW_ClampBolt — DROIDWORKS_BOLT_CORE_1, the field route for fitting a
       restraining bolt. Backs Droidworks.JobDriver_DWClampBolt
       (Source/Droidworks/JobDriver_DWClampBolt.cs): 600 ticks on a DOWNED
       droid, no bill, no ingredient (see the driver's own header for why) —
       mirrors OuterRim_RestrainDroid's own JobDriver_RestrainDroid per
       droid_ruling.md section 3. Wiring a float-menu option / WorkGiver to
       actually ISSUE this job is left as follow-up, same precedent
       DW_RebootDroid's own header set (recipe defined, wiring deferred).
  ======================================================================== -->
  <JobDef>
    <defName>DW_ClampBolt</defName>
    <driverClass>Droidworks.JobDriver_DWClampBolt</driverClass>
    <reportString>clamping a restraining bolt onto TargetA.</reportString>
    <suspendable>false</suspendable>
  </JobDef>

</Defs>
