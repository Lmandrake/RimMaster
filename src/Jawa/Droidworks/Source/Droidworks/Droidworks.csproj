<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RimWorld 1.6 runs Unity/Mono against a .NET Framework 4.7.2 profile, so the
    mod DLL must target net472. There is no Visual Studio or targeting pack on
    this machine, so Microsoft.NETFramework.ReferenceAssemblies supplies the
    reference assemblies from NuGet instead. Copied verbatim from the known-good
    pattern at src/Jawa/JawaIonWeapons/Source/JawaIonWeapons.csproj
    (DROIDWORKS_DLL_COMPILE_1).

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\Jawa\Droidworks\Source\Droidworks\Droidworks.csproj -c Release

    Output lands in ../../Assemblies/ (Source/Droidworks/../../Assemblies =
    Droidworks/Assemblies/), which is where RimWorld looks.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Droidworks</AssemblyName>
    <RootNamespace>Droidworks</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <!-- Nothing but our own DLL should ever be copied next to the mod.
         See traps.md: three mods in this load set shipped the base game's own
         assemblies into their Assemblies folder and it caused silent chaos. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="CompDroidDetonation.cs" />
    <Compile Include="CompDWCharger.cs" />
    <Compile Include="CompDWDataSpike.cs" />
    <Compile Include="CompTargetable_DWDataSpike.cs" />
    <Compile Include="DroidworksBoltUtility.cs" />
    <Compile Include="DroidworksDefOf.cs" />
    <Compile Include="DroidworksModExtension.cs" />
    <Compile Include="HediffComp_DWBoltResentment.cs" />
    <Compile Include="HediffComp_IonOverloadsDroid.cs" />
    <Compile Include="HediffComp_PoweredDown.cs" />
    <Compile Include="JobDriver_DWClampBolt.cs" />
    <Compile Include="JobDriver_DWDataSpike.cs" />
    <Compile Include="JobDriver_DWRecharge.cs" />
    <Compile Include="JobGiver_DWRecharge.cs" />
    <Compile Include="Need_Power.cs" />
    <Compile Include="Recipe_DWMemoryWipe.cs" />
    <Compile Include="Recipe_InstallRestrainingBolt.cs" />
    <Compile Include="Recipe_RebootDroid.cs" />
    <Compile Include="Recipe_RemoveRestrainingBolt.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
