<?xml version="1.0" encoding="utf-8" ?>
<!-- Absorbed from maincrep.eweb (workshop 3555571107, "E-Web Heavy Repeating
     Blaster"), WEAPONS_ABSORPTION_WAVE_1. HAND-PORTED (8-def pack, too small
     to warrant a generator) — defNames preserved verbatim per the item's rule 1.
     Turrets_DamageDoctrine.xml's EWebShot ops and Turrets_Renames.xml's
     RN2SWGun_EWeb_MG label op are retired and baked in HERE instead — both
     were PatchOperationFindMod-gated on "E-Web Heavy Repeating Blaster", which
     stops matching once that pack retires (a patch that matches nothing logs
     nothing). Values confirmed by running gen_turret_doctrine.py before this
     port: EWebShot damageAmountBase 14->368, damageDef Bullet->OuterRim_Blaster.
     Source pack stays active for now (retirement is a separate later step,
     gated on a full-list load proving zero missing-def errors) — do not
     deploy this file until then, or duplicate defNames result. -->
<Defs>

  <ThingDef Abstract="True" Name="RNBaseWeaponTurret" ParentName="BaseWeapon">
    <destroyOnDrop>True</destroyOnDrop>
    <drawerType>MapMeshAndRealTime</drawerType>
    <canGenerateDefaultDesignator>false</canGenerateDefaultDesignator>
    <tradeability>None</tradeability>
    <useHitPoints>false</useHitPoints>
    <weaponTags>
      <li>RN_TurretGun</li>
    </weaponTags>
    <weaponClasses>
      <li>Ranged</li>
    </weaponClasses>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>RN2SWGun_EWeb_MG</defName>
    <label>E-Web repeating blaster</label>
    <!-- label per Jawa_Armoury/Patches/Turrets_Renames.xml (retired by this absorption): "it is a repeating blaster, not a machine gun" -->
    <description>The E-Web was a heavy repeating blaster manufactured by BlasTech Industries. It was one of the most powerful repeating blasters in the Imperial arsenal.</description>
    <thingClass>Building_TurretGun</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/Security/eWeb/eWeb_Tripod</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/Security/eWeb/eWeb_Display</uiIconPath>
    <minifiedDef>MinifiedThing</minifiedDef>
    <altitudeLayer>Building</altitudeLayer>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <thingCategories>
      <li>BuildingsSecurity</li>
    </thingCategories>
    <statBases>
      <Mass>12</Mass>
      <MaxHitPoints>360</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <WorkToBuild>4500</WorkToBuild>
      <Beauty>-60</Beauty>
    </statBases>
    <tickerType>Normal</tickerType>
    <comps>
      <li Class="CompProperties_Mannable">
        <manWorkType>Violent</manWorkType>
      </li>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_Refuelable">
        <fuelLabel>Shots until ammo box change</fuelLabel>
        <fuelGizmoLabel>ammunition box</fuelGizmoLabel>
        <fuelFilter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </fuelFilter>
        <fuelCapacity>200</fuelCapacity>
        <initialFuelPercent>1</initialFuelPercent>
        <autoRefuelPercent>0.1667</autoRefuelPercent>
        <showFuelGizmo>true</showFuelGizmo>
        <minimumFueledThreshold>1</minimumFueledThreshold>
        <atomicFueling>true</atomicFueling>
        <fuelMultiplier>4</fuelMultiplier>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <outOfFuelMessage>Cannot shoot: Needs more ammo</outOfFuelMessage>
        <fuelIconPath>UI/eWebAmmoCan</fuelIconPath>
      </li>
    </comps>
    <size>(2,2)</size>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <fillPercent>0.75</fillPercent>
    <hasTooltip>true</hasTooltip>
    <costList>
      <Steel>105</Steel>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Security</designationCategory>
    <constructEffect>ConstructMetal</constructEffect>
    <specialDisplayRadius>40</specialDisplayRadius>
    <building>
      <ai_combatDangerous>true</ai_combatDangerous>
      <turretGunDef>RN2SWGun_EWebMounted_GPMG</turretGunDef>
      <turretBurstWarmupTime>0.04</turretBurstWarmupTime>
      <turretBurstCooldownTime>0.04</turretBurstCooldownTime>
    </building>
    <researchPrerequisites><li>GunTurrets</li></researchPrerequisites>
  </ThingDef>

  <ThingDef ParentName="RNBaseWeaponTurret">
    <defName>RN2SWGun_EWebMounted_GPMG</defName>
    <label>M60</label>
    <description>The E-Web was a heavy repeating blaster manufactured by BlasTech Industries. It was one of the most powerful repeating blasters in the Imperial arsenal.</description>
    <graphicData>
      <texPath>Things/Building/Security/eWeb/eWeb</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <AccuracyTouch>0.70</AccuracyTouch>
      <AccuracyShort>0.80</AccuracyShort>
      <AccuracyMedium>0.50</AccuracyMedium>
      <AccuracyLong>0.41</AccuracyLong>
      <RangedWeapon_Cooldown>2</RangedWeapon_Cooldown>
      <DeteriorationRate>0</DeteriorationRate>
      <Mass>4</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <defaultProjectile>EWebShot</defaultProjectile>
        <warmupTime>0.05</warmupTime>
        <range>40</range>
        <ticksBetweenBurstShots>7</ticksBetweenBurstShots>
        <burstShotCount>3</burstShotCount>
        <soundCast>RNShotEWebMG</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
        <consumeFuelPerShot>1</consumeFuelPerShot>
      </li>
    </verbs>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>EWebShot</defName>
    <label>7.62x54mmR bullet</label>
    <graphicData>
      <texPath>Things/Red_Laser</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>OuterRim_Blaster</damageDef>
      <damageAmountBase>368</damageAmountBase>
      <stoppingPower>1.0</stoppingPower>
      <speed>65</speed>
    </projectile>
  </ThingDef>

</Defs>
