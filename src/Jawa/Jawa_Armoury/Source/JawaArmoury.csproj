    <Compile Include="KoltoTank\CompKoltoTank.cs" />
    <Compile Include="KoltoTank\CompProperties_SecondLayer.cs" />
    <Compile Include="KoltoTank\CompSecondLayer.cs" />
    <Compile Include="KoltoTank\Kolto_DefOf.cs" />
    <Compile Include="KoltoTank\HARFleshCheck.cs" />
    <Compile Include="KoltoTank\KoltoTankPatches.cs" />
