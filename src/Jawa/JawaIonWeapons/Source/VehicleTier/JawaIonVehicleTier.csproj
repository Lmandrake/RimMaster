<Project Sdk="Microsoft.NET.Sdk">

  <!--
    JawaIonVehicleTier - Harmony hook giving the Jawa ion blaster a real effect on
    Vehicle Framework vehicles (VEHICLE_ION_TIER_1). See VehicleIonPatches.cs for
    the full mechanism.

    net48, NOT net472 like the main JawaIonWeapons.csproj. Vehicle Framework's own
    Vehicles.dll and SmashTools.dll are built against .NET Framework 4.8, and
    MSBuild refuses to resolve a reference built against a higher profile than the
    one being targeted - net472 fails the build outright with MSB3274. Same reason
    DesertVehicleReskin/Source/Fuel/DesertVehicleReskin.csproj is net48; copied
    from that known-good project on this machine. There is no Visual Studio or
    targeting pack here, so Microsoft.NETFramework.ReferenceAssemblies supplies
    the reference assemblies from NuGet instead.

    Build (the dotnet is WINDOWS-NATIVE and cannot take a /mnt/d path):
      "%USERPROFILE%\.dotnet\dotnet.exe" build D:\Luke\dev\Rimworld\src\Jawa\JawaIonWeapons\Source\VehicleTier\JawaIonVehicleTier.csproj -c Release

    Output lands in ../../Assemblies/ - the SAME folder the main
    JawaIonWeapons.csproj (net472) already builds into. RimWorld loads every DLL
    in a mod's Assemblies/ folder regardless of which one targeted which
    framework profile, so the mod ships two assemblies from two separate .csproj
    files with no solution tying them together, same pattern as
    DesertVehicleReskin's own Source/ layout.

    Every reference is Private=false. Nothing but our own DLL may land next to
    the mod: shipping a copy of Vehicles.dll or 0Harmony.dll would give the game
    two of each and Harmony in particular must come from brrainz.harmony. This
    project does NOT reference JawaIonWeapons.dll (the sibling net472 output) -
    VehicleIonPatches.cs reads IonDamageDef's empAmountDroid field by reflection
    instead, deliberately, so the two assemblies build in either order.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>JawaIonVehicleTier</AssemblyName>
    <RootNamespace>JawaIonWeapons</RootNamespace>
    <Version>1.0.0</Version>

    <OutputPath>..\..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblySearchPaths>$(AssemblySearchPaths);$(RimWorldManaged)</AssemblySearchPaths>

    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimWorldManaged)' == ''">
    <RimWorldManaged>C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</RimWorldManaged>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HarmonyDll)' == ''">
    <HarmonyDll>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HarmonyDll>
  </PropertyGroup>

  <!-- Vehicle Framework (SmashPhil). -->
  <PropertyGroup Condition="'$(VehiclesAssemblies)' == ''">
    <VehiclesAssemblies>C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\3014915404\1.6\Assemblies</VehiclesAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Vehicles">
      <HintPath>$(VehiclesAssemblies)\Vehicles.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SmashTools">
      <HintPath>$(VehiclesAssemblies)\SmashTools.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="..\**\*.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>

</Project>
