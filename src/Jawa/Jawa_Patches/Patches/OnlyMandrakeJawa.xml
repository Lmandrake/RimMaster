<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  OnlyMandrakeJawa.xml                       Jawa_Patches · authored 2026-08-14
  ============================================================================

  OWNER'S RULING, 2026-08-14, verbatim: "the xenotype MandrakeJawa is the ONLY
  Jawa xenotype active anymore."

  THE THREE THAT ARE BEING STOOD DOWN, read from the live def dump 2026-08-14:
      OuterRim_Jawa          Outer Rim - Galactic Diversity
      guy762_xenotype_jawa   Star Wars Xenotypes
      BTD_Jawa               [BTD] Xenotype REMIX: Star Wars

  🔴 WHY THIS SUPPRESSES RATHER THAN DELETES
  ==========================================
  `tile_augmentation_catalogue.md` §5, standing: **never cull a spawned def.**
  These three are referenced by PawnKindDefs, faction xenotype sets and namers
  belonging to mods we do not own. Removing the defs would leave every one of
  those references dangling, and a dangling xenotype reference is a red error at
  best and a null pawn at worst. Setting the generation weights to zero achieves
  the owner's intent — no new pawn is ever a Jawa of the wrong kind — while
  leaving every existing reference resolvable.

  ⚠️ WHAT THIS DOES NOT DO, deliberately:
  - It does not retroactively change pawns already generated in a save. An
    existing colony's Jawa keep whatever xenotype they were born with.
  - It does not stop a modded PawnKindDef that names one of these xenotypes
    EXPLICITLY in its own `xenotypeSet`. Those are hard references, not weighted
    rolls. If one turns up in play, patch that PawnKindDef, not this file.
  - `Jawa_Xeno_Gamorrean` is NOT touched. It is ours, it is a Gamorrean, and it
    is not a Jawa xenotype despite the `Jawa_` prefix, which is our mod's
    namespace and not a species claim.

  🔴 REPAIRED 2026-08-15. Every operation in this file used
  `PatchOperationAddOrReplace`, WHICH IS NOT A REAL PATCH TYPE. No mod on the
  install defines it and RimWorld has no such class, so all six operations were
  dead: 12 x `Could not find type named PatchOperationAddOrReplace` in the log,
  and the suppression this file exists for had never once run. All three rival
  Jawa xenotypes were still generating.
  The real idiom is `PatchOperationConditional`: test whether the field exists,
  `Replace` it if so, `Add` it if not. Both fields are ABSENT on all three
  shipped defs, so in practice the nomatch/Add branch is the one that fires.

  Each operation is wrapped in `PatchOperationFindMod` so a mod leaving the load
  order makes this file a silent no-op instead of a red error.
  ============================================================================
-->
<Patch>

  <!-- Outer Rim - Galactic Diversity -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Outer Rim - Galactic Diversity</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/XenotypeDef[defName="OuterRim_Jawa"]/factionlessGenerationWeight</xpath>
          <match Class="PatchOperationReplace">
            <xpath>/Defs/XenotypeDef[defName="OuterRim_Jawa"]/factionlessGenerationWeight</xpath>
            <value><factionlessGenerationWeight>0</factionlessGenerationWeight></value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/XenotypeDef[defName="OuterRim_Jawa"]</xpath>
            <value><factionlessGenerationWeight>0</factionlessGenerationWeight></value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/XenotypeDef[defName="OuterRim_Jawa"]/canGenerateAsCombatant</xpath>
          <match Class="PatchOperationReplace">
            <xpath>/Defs/XenotypeDef[defName="OuterRim_Jawa"]/canGenerateAsCombatant</xpath>
            <value><canGenerateAsCombatant>false</canGenerateAsCombatant></value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/XenotypeDef[defName="OuterRim_Jawa"]</xpath>
            <value><canGenerateAsCombatant>false</canGenerateAsCombatant></value>
          </nomatch>
        </li>
      </operations>
    </match>
  </Operation>

  <!-- Star Wars Xenotypes -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Star Wars Xenotypes</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/XenotypeDef[defName="guy762_xenotype_jawa"]/factionlessGenerationWeight</xpath>
          <match Class="PatchOperationReplace">
            <xpath>/Defs/XenotypeDef[defName="guy762_xenotype_jawa"]/factionlessGenerationWeight</xpath>
            <value><factionlessGenerationWeight>0</factionlessGenerationWeight></value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/XenotypeDef[defName="guy762_xenotype_jawa"]</xpath>
            <value><factionlessGenerationWeight>0</factionlessGenerationWeight></value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/XenotypeDef[defName="guy762_xenotype_jawa"]/canGenerateAsCombatant</xpath>
          <match Class="PatchOperationReplace">
            <xpath>/Defs/XenotypeDef[defName="guy762_xenotype_jawa"]/canGenerateAsCombatant</xpath>
            <value><canGenerateAsCombatant>false</canGenerateAsCombatant></value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/XenotypeDef[defName="guy762_xenotype_jawa"]</xpath>
            <value><canGenerateAsCombatant>false</canGenerateAsCombatant></value>
          </nomatch>
        </li>
      </operations>
    </match>
  </Operation>

  <!-- [BTD] Xenotype REMIX: Star Wars -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>[BTD] Xenotype REMIX: Star Wars</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/XenotypeDef[defName="BTD_Jawa"]/factionlessGenerationWeight</xpath>
          <match Class="PatchOperationReplace">
            <xpath>/Defs/XenotypeDef[defName="BTD_Jawa"]/factionlessGenerationWeight</xpath>
            <value><factionlessGenerationWeight>0</factionlessGenerationWeight></value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/XenotypeDef[defName="BTD_Jawa"]</xpath>
            <value><factionlessGenerationWeight>0</factionlessGenerationWeight></value>
          </nomatch>
        </li>
        <li Class="PatchOperationConditional">
          <xpath>/Defs/XenotypeDef[defName="BTD_Jawa"]/canGenerateAsCombatant</xpath>
          <match Class="PatchOperationReplace">
            <xpath>/Defs/XenotypeDef[defName="BTD_Jawa"]/canGenerateAsCombatant</xpath>
            <value><canGenerateAsCombatant>false</canGenerateAsCombatant></value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/XenotypeDef[defName="BTD_Jawa"]</xpath>
            <value><canGenerateAsCombatant>false</canGenerateAsCombatant></value>
          </nomatch>
        </li>
      </operations>
    </match>
  </Operation>

</Patch>
