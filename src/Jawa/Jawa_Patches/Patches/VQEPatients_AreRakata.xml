<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- VQE-Ancients quest patients are Rakata sleepers (owner's lore ruling
       2026-08-29, ANCIENTS_AS_RAKATA_SPEC.md "who EMERGES").
       The 2026-08-29 Cherry Picker cut removed VQE's 27 backstories and the
       VQE_IdealPatient TraitDef, which left VQE_Experiment referencing three
       cut defs BY NAME (fixedChild/fixedAdultBackstories + forcedTraits) — a
       latent cross-reference error, not just an empty pool. This repoints the
       fixed slots at the Jawa_PawnFlavor Rakata solids and drops the dead
       forcedTraits (Jawa_RakataFleshShaped forces BodyPurist itself).
       The shuffled VQE_AncientPatient pool needs no patch — Jawa_PawnFlavor's
       Rakata backstories carry that spawnCategory directly.
       Jawa_PawnFlavor always rides alongside this mod, so the defNames in the
       values resolve; the guard below is for VQE's absence, not ours. -->

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Quests Expanded - Ancients</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>Defs/PawnKindDef[defName="VQE_Experiment"]/fixedChildBackstories</xpath>
          <value>
            <fixedChildBackstories>
              <li>Jawa_RakataTakenChild</li>
            </fixedChildBackstories>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/PawnKindDef[defName="VQE_Experiment"]/fixedAdultBackstories</xpath>
          <value>
            <fixedAdultBackstories>
              <li>Jawa_RakataFleshShaped</li>
            </fixedAdultBackstories>
          </value>
        </li>
        <li Class="PatchOperationRemove">
          <xpath>Defs/PawnKindDef[defName="VQE_Experiment"]/forcedTraits</xpath>
        </li>
      </operations>
    </match>
  </Operation>

</Patch>
