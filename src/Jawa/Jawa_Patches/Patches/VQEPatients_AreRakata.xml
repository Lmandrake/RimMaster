<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- VQE-Ancients quest patients are Rakata sleepers (owner's lore ruling
       2026-08-29, ANCIENTS_AS_RAKATA_SPEC.md "who EMERGES").
       The 2026-08-29 Cherry Picker cut removed VQE's 27 backstories and the
       VQE_IdealPatient TraitDef, which left VQE_Experiment referencing three
       cut defs BY NAME (fixedChild/fixedAdultBackstories + forcedTraits) — a
       latent cross-reference error, not just an empty pool. This repoints the
       fixed slots at the Jawa_PawnFlavor Rakata solids and drops the dead
       forcedTraits (Jawa_RakataFleshShaped forces BodyPurist itself).
       The shuffled VQE_AncientPatient pool needs no patch — Jawa_PawnFlavor's
       Rakata backstories carry that spawnCategory directly.
       Jawa_PawnFlavor always rides alongside this mod, so the defNames in the
       values resolve; the guard below is for VQE's absence, not ours. -->

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Quests Expanded - Ancients</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>Defs/PawnKindDef[defName="VQE_Experiment"]/fixedChildBackstories</xpath>
          <value>
            <fixedChildBackstories>
              <li>Jawa_RakataTakenChild</li>
            </fixedChildBackstories>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/PawnKindDef[defName="VQE_Experiment"]/fixedAdultBackstories</xpath>
          <value>
            <fixedAdultBackstories>
              <li>Jawa_RakataFleshShaped</li>
            </fixedAdultBackstories>
          </value>
        </li>
        <li Class="PatchOperationRemove">
          <xpath>Defs/PawnKindDef[defName="VQE_Experiment"]/forcedTraits</xpath>
        </li>
        <!-- Childhood slot: VQE's own override filters ONLY adulthood, so
             childhoods drew from the global pool - measured live 2026-08-29,
             5/9 spawned patients carried donor-mod childhoods (one a droid's).
             Constrain both slots to the Rakata category. -->
        <li Class="PatchOperationReplace">
          <xpath>Defs/PawnKindDef[defName="VQE_Patient"]/backstoryFiltersOverride</xpath>
          <value>
            <backstoryFiltersOverride>
              <li>
                <categories>
                  <li>VQE_AncientPatient</li>
                </categories>
              </li>
            </backstoryFiltersOverride>
          </value>
        </li>
        <!-- The patients LOOK Rakatan too (owner, 2026-08-29). Same shape as
             AncientsAreRakata.xml, per ANCIENTS_AS_RAKATA_SPEC.md R-A3/R-A4:
             dictionary-keyed (never <li> - that discards the whole def),
             Inherit="False" on set AND chances, Remove-then-Add with
             success Always because neither kind declares a xenotypeSet or
             useFactionXenotypes in source. -->
        <li Class="PatchOperationRemove">
          <xpath>Defs/PawnKindDef[defName="VQE_Patient" or defName="VQE_Experiment"]/xenotypeSet</xpath>
          <success>Always</success>
        </li>
        <li Class="PatchOperationRemove">
          <xpath>Defs/PawnKindDef[defName="VQE_Patient" or defName="VQE_Experiment"]/useFactionXenotypes</xpath>
          <success>Always</success>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/PawnKindDef[defName="VQE_Patient"]</xpath>
          <value>
            <xenotypeSet Inherit="False">
              <xenotypeChances Inherit="False">
                <RimMandrakeRakata MayRequire="mandrake.starwarsraces">1.0</RimMandrakeRakata>
              </xenotypeChances>
            </xenotypeSet>
            <useFactionXenotypes>false</useFactionXenotypes>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/PawnKindDef[defName="VQE_Experiment"]</xpath>
          <value>
            <xenotypeSet Inherit="False">
              <xenotypeChances Inherit="False">
                <RimMandrakeRakata MayRequire="mandrake.starwarsraces">1.0</RimMandrakeRakata>
              </xenotypeChances>
            </xenotypeSet>
            <useFactionXenotypes>false</useFactionXenotypes>
          </value>
        </li>
      </operations>
    </match>
  </Operation>

</Patch>
