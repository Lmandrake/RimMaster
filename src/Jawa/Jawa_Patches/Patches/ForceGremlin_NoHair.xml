<?xml version="1.0" encoding="utf-8"?>
<!-- The Yoder force gremlin grows no hair and no beard.

     Hair_BaldOnly and Beard_NoBeardOnly are VANILLA Biotech genes - Hair_BaldOnly
     whitelists the "Bald" hair tag, Beard_NoBeardOnly the beardless one - so this
     needs no new content.

     Safe to Add: <genes> is declared directly on the XenotypeDef, not inherited, and
     an add-if-missing aimed at an inherited container is the trap that silently
     kills a patch. The gremlin's existing Hair_DarkBrown is a hair COLOUR gene
     (exclusionTag HairColor), so it does not collide with a hair STYLE gene.
-->
<Patch>
  <!-- ⚠️ DELIBERATELY NOT wrapped in PatchOperationConditional, and validate_patch.py
       WARNS about that on every run. Leave it. The target is OUR OWN mod
       (mandrake.rsw.starwarsraces, RimMandrakeXenotypes.xml), so "the mod might be absent"
       does not apply - if it were, this patch has bigger problems than a red line. A
       Conditional here would convert "our own def got renamed and the fix stopped
       applying" into silence. Verified 2026-08-23: 1 match. -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/XenotypeDef[defName="RSW_RimMandrakeYoderForceGremlin"]/genes</xpath>
    <value>
      <li>Hair_BaldOnly</li>
      <li>Beard_NoBeardOnly</li>
    </value>
  </Operation>
</Patch>
