  <!-- 🔴 HERGLIC AND KLATOONIAN CARRIED NO SIZE GENE AT ALL, cosmetic or otherwise, and
       both are large in lore: a Herglic is ~2.2 m and whale-descended, canonically too
       bulky for human corridors, and a Klatooinian is "often nearly 2 m" with a strong
       build. These are ADDs, not swaps - there is nothing to replace. -->

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/XenotypeDef[defName="RimMandrakeHerglic"]/genes</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/XenotypeDef[defName="RimMandrakeHerglic"]/genes</xpath>
      <value><li MayRequire="redmattis.bigsmall.core">BS_LargeFrame</li></value>
    </match>
