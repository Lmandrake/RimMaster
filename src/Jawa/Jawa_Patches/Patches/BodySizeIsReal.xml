    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/XenotypeDef[defName="RimMandrakeHerglic"]/genes</xpath>
      <value><li MayRequire="redmattis.bigsmall.core">HalfJotunFrame</li></value>
