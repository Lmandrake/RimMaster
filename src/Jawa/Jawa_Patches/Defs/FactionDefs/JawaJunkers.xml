<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  JawaJunkers.xml                             Jawa_Patches · authored 2026-08-14
  ============================================================================

  FACTION_SPEC.md section 12. Faction 12 of 14.

  ParentName is `PirateBandBase` (R24), which supplies the pirate art, namers,
  raid loot maker, arrival temperature range and a full set of pawnGroupMakers.
  It is the only one of the seven authored factions that does not inherit
  `OutlanderFactionBase`.

  🔴 `permanentEnemy` MUST BE RESTATED FALSE. `PirateBandBase` sets it TRUE, and
  R12 rules the Junkers bribable: hostile on sight, but they can be bought. An
  inherited field is not a set field, and leaving this one out silently makes
  them unnegotiable forever.

  🔴 `colorSpectrum` is inherited from `PirateBandBase` — pirate pink — and is
  overridden here to R22's scrap brown.

  ✅ THE IDEO BLOCK IS IN THIS FILE. R23 said to omit it and add it in one pass
  when the text existed; the text exists (`faction_religions_spec.md`) and that
  pass landed here rather than in a separate file. 🔴 It has to be here before
  the worldgen click: an ideo is generated once, at world creation, and a
  `fixedIdeo` added afterwards does not retrofit an existing world.

  ⛔ NO TRADER GROUP. `canRequestTraders` is false. The Junkers are a loot
  source, not a market.

  Pawn kinds verified present in the 2026-08-14 dump (585 mods) and mapped to
  their owning mod for `MayRequire`:
      OuterRim_Scavenger · OuterRim_Thrasher    Neronix17.OuterRim.Core
      VFEP_Scrapper                             OskarPotocki.VFE.Pirates
      Scavenger · Thrasher                      vanilla Core, no MayRequire
      Jawa_Gamorrean_*                          OURS, this same mod, no MayRequire
  ============================================================================
-->
<Defs>

  <FactionDef ParentName="PirateBandBase">
    <defName>Jawa_Junkers</defName>
    <label>the Junkers</label>
    <description>The bottom of the scrap heap, given weapons and a grudge. Scavengers who arrive second and kill whoever arrived first, welded into warcaskets cut off other people's bodies.\n\nThere is no doctrine down there, only the ladder. Which means there is always somebody who would rather be paid than climb it.</description>
    <pawnSingular>Junker</pawnSingular>
    <pawnsPlural>Junkers</pawnsPlural>
    <leaderTitle>Scraplord</leaderTitle>
    <categoryTag>Pirate</categoryTag>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <techLevel>Industrial</techLevel>
    <humanlikeFaction>true</humanlikeFaction>
    <canMakeRandomly>true</canMakeRandomly>
    <!-- 8 settlements, wreck fields and tailings. -->
    <settlementGenerationWeight>1.15</settlementGenerationWeight>
    <!-- 🔴 RESTATED. PirateBandBase sets this true; R12 says bribable. -->
    <permanentEnemy>false</permanentEnemy>
    <naturalEnemy>false</naturalEnemy>
    <!-- No caravans. A loot source, not a market. -->
    <canRequestTraders>false</canRequestTraders>

    <factionNameMaker>NamerFactionSalvagers</factionNameMaker>
    <settlementNameMaker>NamerSettlementPirate</settlementNameMaker>
    <factionIconPath>UI/FactionIcons/JunkersOutpost</factionIconPath>
    <!-- The icon ships in Vanilla Factions Expanded - Pirates
         (oskarpotocki.vfe.pirates), which is active. A texture path has no
         MayRequire; if that mod ever leaves the list the icon goes pink. -->
    <!-- R22: scrap brown. Overrides the inherited pirate spectrum. -->
    <colorSpectrum>
      <li>(0.55,0.35,0.20)</li>
      <li>(0.38,0.24,0.14)</li>
    </colorSpectrum>

    <!--
      ================================================================
      faction_religions_spec.md entry 11 (B54)
      ================================================================
      `ideoName` and `ideoDescription` are verbatim from the spec; they are
      the only strings the engine renders. Structure meme goes FIRST in
      `forcedMemes`. ⛔ `hiddenIdeo` MUST STAY UNSET — setting it suppresses
      the description entirely, which is the whole deliverable.
    -->
    <fixedIdeo>true</fixedIdeo>
    <requiredPreceptsOnly>true</requiredPreceptsOnly>
    <ideoName>the Weight</ideoName>
    <ideoDescription>We have no word for what we believe, because belief is not worn and everything real is worn. Weight is rank. What is bolted to you was cut off somebody slower, and the one who cuts it off you will be told what we were told: it was never yours, you were only carrying it a while. Nothing is wasted in the warrens. Not the plate. Not the meat.</ideoDescription>
    <forcedMemes>
      <li MayRequire="sarg.alphamemes">AM_Structure_Scavenger</li>
      <li>Raider</li>
      <li>Cannibal</li>
      <li MayRequire="vanillaexpanded.vmemese">VME_Scrapper</li>
    </forcedMemes>

    <!-- R27: `xenotypeSet` is the SECOND inherit trap. `OutlanderFactionBase`
         ships five vanilla xenotypes (Hussar · Dirtmole · Genie · Neanderthal ·
         Starjack) and `PirateBandBase` ships nine; a child set is APPENDED to
         them, so without this opt-out the faction fields Hussars in a Star Wars
         campaign. `BTD_` and not `OuterRim_`: three packs ship overlapping
         xenotypes and BTD Remix DEDUPS AT LOAD, so `BTD_Jawa` survives live
         while `OuterRim_Jawa` does not exist at runtime.
         ⚠️ The CHANCES are BUILD's, not the spec's — R27 gives species, not
         numbers. They sum to ~1.00, with the dossier
         lead species heaviest.
         ⚠️ Baseliner is one of the entries and it is NOT zero, so plain humans DO
         generate at that rate. The comment used to claim otherwise. Retune freely;
         nothing depends on them. -->
    <xenotypeSet Inherit="False">
      <xenotypeChances>
        <RimMandrakeChadraFan MayRequire="mandrake.starwarsraces">0.140</RimMandrakeChadraFan>
        <RimMandrakeFeeorin MayRequire="mandrake.starwarsraces">0.140</RimMandrakeFeeorin>
        <RimMandrakeGamorrean MayRequire="mandrake.starwarsraces">0.140</RimMandrakeGamorrean>
        <RimMandrakeGand MayRequire="mandrake.starwarsraces">0.140</RimMandrakeGand>
        <RimMandrakeAqualish MayRequire="mandrake.starwarsraces">0.047</RimMandrakeAqualish>
        <Baseliner>0.047</Baseliner>
        <RimMandrakeNikto MayRequire="mandrake.starwarsraces">0.047</RimMandrakeNikto>
        <RimMandrakeRodian MayRequire="mandrake.starwarsraces">0.047</RimMandrakeRodian>
        <RimMandrakeSnivvian MayRequire="mandrake.starwarsraces">0.047</RimMandrakeSnivvian>
        <RimMandrakeTrandoshan MayRequire="mandrake.starwarsraces">0.047</RimMandrakeTrandoshan>
        <RimMandrakeUgnaught MayRequire="mandrake.starwarsraces">0.047</RimMandrakeUgnaught>
        <RimMandrakeWeequay MayRequire="mandrake.starwarsraces">0.047</RimMandrakeWeequay>
        <RimMandrakeDuros MayRequire="mandrake.starwarsraces">0.014</RimMandrakeDuros>
        <RimMandrakeKubaz MayRequire="mandrake.starwarsraces">0.014</RimMandrakeKubaz>
        <RimMandrakePantoran MayRequire="mandrake.starwarsraces">0.014</RimMandrakePantoran>
        <RimMandrakeTwilek MayRequire="mandrake.starwarsraces">0.014</RimMandrakeTwilek>
        <RimMandrakeZygerrian MayRequire="mandrake.starwarsraces">0.014</RimMandrakeZygerrian>
      </xenotypeChances>
    </xenotypeSet>

    <!-- Inherit="False" IS LOAD-BEARING. RimWorld resolves inheritance AFTER
         patches, and a child `li` list is APPENDED to the parent's, not
         substituted for it. `PirateBandBase` carries 7 group makers; without
         this opt-out the faction fields those too and raids arrive as
         vanilla pawns wearing our name. Vanilla itself writes it 314 times,
         9 of them on pawnGroupMakers. -->
    <pawnGroupMakers Inherit="False">
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <Jawa_Gamorrean_Guard>10</Jawa_Gamorrean_Guard>
          <Jawa_Gamorrean_Enforcer>3</Jawa_Gamorrean_Enforcer>
          <OuterRim_Scavenger MayRequire="Neronix17.OuterRim.Core">6</OuterRim_Scavenger>
          <OuterRim_Thrasher MayRequire="Neronix17.OuterRim.Core">6</OuterRim_Thrasher>
          <VFEP_Scrapper MayRequire="OskarPotocki.VFE.Pirates">4</VFEP_Scrapper>
          <Scavenger>3</Scavenger>
          <Thrasher>3</Thrasher>
        </options>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Jawa_Gamorrean_Guard>8</Jawa_Gamorrean_Guard>
          <OuterRim_Scavenger MayRequire="Neronix17.OuterRim.Core">5</OuterRim_Scavenger>
        </options>
      </li>
    </pawnGroupMakers>
  </FactionDef>

</Defs>
