<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  JawaAscendantHelix.xml                      Jawa_Patches · authored 2026-08-14
  ============================================================================

  FACTION_SPEC.md section 9. Faction 9 of 14.

  ParentName is `OutlanderFactionBase` (R24), which supplies factionNameMaker,
  settlementNameMaker, factionIconPath, techLevel Industrial, leaderTitle,
  allowedArrivalTemperatureRange and a full set of pawnGroupMakers. Everything
  restated below is either a value the parent does not give at all, or one the
  dossier contradicts.

  🔴 AUTHORED, NOT A RESKIN (R9). `Ancients` looks like the obvious vessel and
  cannot host a faction: it is hidden, settlementGenerationWeight 0 and
  canMakeRandomly false.

  The namers and the icon are the Empire set (R16/R17) — the Helix is small,
  rich and formal, and the empire art is the only thing in the set that reads
  that way. `leaderTitle` Director belongs here and not to the Empire (R11).

  🔴 `colorSpectrum` IS NOT INHERITED. Measured on the shipped abstracts:
  `OutlanderFactionBase` and `TribeBase` supply NO colorSpectrum — only
  `PirateBandBase` does. R24's table says otherwise and is wrong on that one
  field. A faction without it is set on 76 of 87 live defs, so the world map
  draws it broken. It is set explicitly here and in all six siblings.

  ✅ THE IDEO BLOCK IS IN THIS FILE. R23 said to omit it and add it in one pass
  when the text existed; the text exists (`faction_religions_spec.md`) and that
  pass landed here rather than in a separate file. 🔴 It has to be here before
  the worldgen click: an ideo is generated once, at world creation, and a
  `fixedIdeo` added afterwards does not retrofit an existing world.

  Pawn kinds verified present in the 2026-08-14 dump (585 mods) and mapped to
  their owning mod for `MayRequire`:
      RimMandrake_Arkanian · RimMandrake_ArkanianTribal · RimMandrake_Kaminoan
                                                            mandrake.starwarsraces
  ============================================================================
-->
<Defs>

  <FactionDef ParentName="OutlanderFactionBase">
    <defName>Jawa_AscendantHelix</defName>
    <label>Ascendant Helix</label>
    <description>A small, obscenely wealthy gene-cult that believes the body is a rough draft and the species is a project — and despises the manufactured underclass it made itself.\n\nIt does not raid. It retrieves. What it comes for is usually a person, and it has already decided which one.</description>
    <pawnSingular>curator</pawnSingular>
    <pawnsPlural>curators</pawnsPlural>
    <leaderTitle>Director</leaderTitle>
    <categoryTag>Outlander</categoryTag>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <techLevel>Spacer</techLevel>
    <humanlikeFaction>true</humanlikeFaction>
    <canMakeRandomly>true</canMakeRandomly>
    <!-- 3 settlements, isolated and secure. -->
    <settlementGenerationWeight>0.45</settlementGenerationWeight>
    <!-- Neutral. Retrieval operations, not raids. -->
    <permanentEnemy>false</permanentEnemy>
    <naturalEnemy>false</naturalEnemy>
    <canRequestTraders>true</canRequestTraders>

    <factionNameMaker>NamerFactionEmpire</factionNameMaker>
    <settlementNameMaker>NamerSettlementEmpire</settlementNameMaker>
    <factionIconPath>World/WorldObjects/Expanding/Empire</factionIconPath>
    <!-- R22: pale violet. -->
    <colorSpectrum>
      <li>(0.78,0.74,0.85)</li>
      <li>(0.62,0.58,0.72)</li>
    </colorSpectrum>

    <!--
      ================================================================
      faction_religions_spec.md entry 9 (B54)
      ================================================================
      `ideoName` and `ideoDescription` are verbatim from the spec; they are
      the only strings the engine renders. Structure meme goes FIRST in
      `forcedMemes`. ⛔ `hiddenIdeo` MUST STAY UNSET — setting it suppresses
      the description entirely, which is the whole deliverable.
    -->
    <fixedIdeo>true</fixedIdeo>
    <requiredPreceptsOnly>true</requiredPreceptsOnly>
    <ideoName>the Ascendant Genome</ideoName>
    <ideoDescription>The body you were born in is a first draft written by no one. We are the second draft, and there will be a third. Every improvement is permitted, recorded, and slow — haste is how you get monsters, and this world is already littered with ours. We do not hate the labour-lines. You do not hate a paragraph you cut. You simply do not let it speak.</ideoDescription>
    <forcedMemes>
      <li>Structure_Ideological</li>
      <li>Transhumanist</li>
      <li>Supremacist</li>
      <li MayRequire="vanillaexpanded.vgeneticse">GR_CarefulGeneticists</li>
    </forcedMemes>

    <!-- R27: `xenotypeSet` is the SECOND inherit trap. `OutlanderFactionBase`
         ships five vanilla xenotypes (Hussar · Dirtmole · Genie · Neanderthal ·
         Starjack) and `PirateBandBase` ships nine; a child set is APPENDED to
         them, so without this opt-out the faction fields Hussars in a Star Wars
         campaign. The species below are this repo's own, copied out of the
         three colliding packs so none of them has to stay installed.
         ⚠️ The CHANCES are BUILD's, not the spec's — R27 gives species, not
         numbers. They sum to ~1.00, with the dossier
         lead species heaviest.
         ⚠️ Baseliner is one of the entries and it is NOT zero, so plain humans DO
         generate at that rate. The comment used to claim otherwise. Retune freely;
         nothing depends on them. -->
    <xenotypeSet Inherit="False">
      <xenotypeChances>
        <RimMandrakeArkanian MayRequire="mandrake.starwarsraces">0.248</RimMandrakeArkanian>
        <Baseliner>0.083</Baseliner>
        <RimMandrakeBith MayRequire="mandrake.starwarsraces">0.083</RimMandrakeBith>
        <RimMandrakeCerean MayRequire="mandrake.starwarsraces">0.083</RimMandrakeCerean>
        <RimMandrakeKaminoan MayRequire="mandrake.starwarsraces">0.083</RimMandrakeKaminoan>
        <RimMandrakeMuun MayRequire="mandrake.starwarsraces">0.083</RimMandrakeMuun>
        <RimMandrakeNeimoidian MayRequire="mandrake.starwarsraces">0.083</RimMandrakeNeimoidian>
        <RimMandrakeUmbaran MayRequire="mandrake.starwarsraces">0.083</RimMandrakeUmbaran>
        <RimMandrakeIktotchi MayRequire="mandrake.starwarsraces">0.025</RimMandrakeIktotchi>
        <RimMandrakeKelDor MayRequire="mandrake.starwarsraces">0.025</RimMandrakeKelDor>
        <RimMandrakeKubaz MayRequire="mandrake.starwarsraces">0.025</RimMandrakeKubaz>
        <RimMandrakeRakata MayRequire="mandrake.starwarsraces">0.025</RimMandrakeRakata>
        <RimMandrakeSithKissaiPureblood MayRequire="mandrake.starwarsraces">0.025</RimMandrakeSithKissaiPureblood>
        <RimMandrakeSithMassassi MayRequire="mandrake.starwarsraces">0.025</RimMandrakeSithMassassi>
        <RimMandrakeSithZ MayRequire="mandrake.starwarsraces">0.025</RimMandrakeSithZ>
      </xenotypeChances>
    </xenotypeSet>

    <!-- Inherit="False" IS LOAD-BEARING. RimWorld resolves inheritance AFTER
         patches, and a child `li` list is APPENDED to the parent's, not
         substituted for it. `OutlanderFactionBase` carries 8 group makers; without
         this opt-out the faction fields those too and raids arrive as
         vanilla pawns wearing our name. Vanilla itself writes it 314 times,
         9 of them on pawnGroupMakers. -->
    <pawnGroupMakers Inherit="False">
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <Jawa_Helix_Grunt>10</Jawa_Helix_Grunt>
          <Jawa_Helix_Heavy>4</Jawa_Helix_Heavy>
          <Jawa_Helix_Specialist>2</Jawa_Helix_Specialist>
          <Jawa_Helix_Leader>1</Jawa_Helix_Leader>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <RimMandrake_Kaminoan MayRequire="mandrake.starwarsraces">1</RimMandrake_Kaminoan>
        </traders>
        <guards>
          <RimMandrake_Arkanian MayRequire="mandrake.starwarsraces">6</RimMandrake_Arkanian>
        </guards>
        <carriers>
          <Muffalo>6</Muffalo>
        </carriers>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Jawa_Helix_Grunt>10</Jawa_Helix_Grunt>
          <Jawa_Helix_Heavy>3</Jawa_Helix_Heavy>
          <Jawa_Helix_Specialist>2</Jawa_Helix_Specialist>
        </options>
      </li>
    </pawnGroupMakers>
  </FactionDef>

</Defs>
