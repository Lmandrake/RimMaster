<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  JawaDeepwaterCompact.xml                    Jawa_Patches · authored 2026-08-14
  ============================================================================

  FACTION_SPEC.md section 7. Faction 7 of 14.

  ParentName is `OutlanderFactionBase` (R24), which supplies factionNameMaker,
  settlementNameMaker, factionIconPath, techLevel Industrial, leaderTitle,
  allowedArrivalTemperatureRange and a full set of pawnGroupMakers. Everything
  restated below is either a value the parent does not give at all, or one the
  dossier contradicts.

  🔴 `raidsForbidden` IS THE FACTION. Wardens dehydrate away from water, so this
  faction never reaches the player as a raid. The Combat group below is KEPT
  ANYWAY: it is what defends the settlement when the player attacks it, and
  deleting it would leave an undefended base.

  🔴 `colorSpectrum` IS NOT INHERITED. Measured on the shipped abstracts:
  `OutlanderFactionBase` and `TribeBase` supply NO colorSpectrum — only
  `PirateBandBase` does. R24's table says otherwise and is wrong on that one
  field. A faction without it is set on 76 of 87 live defs, so the world map
  draws it broken. It is set explicitly here and in all six siblings.

  ✅ THE IDEO BLOCK IS IN THIS FILE. R23 said to omit it and add it in one pass
  when the text existed; the text exists (`faction_religions_spec.md`) and that
  pass landed here rather than in a separate file. 🔴 It has to be here before
  the worldgen click: an ideo is generated once, at world creation, and a
  `fixedIdeo` added afterwards does not retrofit an existing world.

  Pawn kinds verified present in the 2026-08-14 dump (585 mods) and mapped to
  their owning mod for `MayRequire`:
      RSW_Quarren · RSW_QuarrenTribal · RSW_MonCalamari
                                                            mandrake.rsw.starwarsraces
  ============================================================================
-->
<Defs>

  <FactionDef ParentName="OutlanderFactionBase">
    <defName>Jawa_DeepwaterCompact</defName>
    <label>Deepwater Compact</label>
    <fixedName>Deepwater Compact</fixedName>
    <description>The amphibian peoples who live in the deep water and sell it to everyone, including the Empire that is hunting you. Their neutrality is a monopoly with teeth.\n\nTheir wardens cannot follow you inland, and both of you know it. Everything the Compact wants from the desert, it buys.</description>
    <pawnSingular>water warden</pawnSingular>
    <pawnsPlural>water wardens</pawnsPlural>
    <leaderTitle>High Warden</leaderTitle>
    <!-- 🔴 WITHOUT THIS THE FACTION IS NOT ON THE CONFIGURE FACTIONS SCREEN, and a world
         built through that screen may not contain it at all. Measured 2026-08-22
         (AUTHORED_FACTIONS_OFF_THE_SCREEN_1): seven of our eight read -1 here.
         `FactionGenerator.ConfigurableFactions` is
             from f in DefDatabase<FactionDef>.AllDefs
             where f.maxConfigurableAtWorldCreation > 0
             orderby f.configurationListOrderPriority
         and vanilla writes 9999 on the CONCRETE defs (OutlanderCivil, TribeCivil,
         Pirate), never on the abstract bases we inherit - so ours defaulted to -1.
         ⚠️ `requiredCountAtGameStart` is NOT a safety net for this.
         `FactionGenerator.InitializeFactions` reads it ONLY when `factions == null`;
         worldgen through the screen passes the configured list and adds it verbatim.
         A dev quicktest takes the null path, which is why these factions generated
         when CHECK measured them and why that measurement does not transfer.
         ⛔ Set on OUR def, never on the abstract base - patching OutlanderFactionBase
         would hand a screen row to every outlander faction in 578 mods.
         🔑 The priority sorts ASCENDING, so the negative numbers put the campaign's own
         eight factions at the TOP of the page the owner builds the one world from.
         Vanilla's own rows are 10-60. -->
    <!-- 🔴 LEADER_TITLES_ON_THE_IDEO_1. `Faction.LeaderTitle` reads the primary IDEO's
         `leaderTitleMale` and only falls back to this def's `leaderTitle`, which is why the
         authored title was invisible on 36 of 37 factions. The ideo's title is generated
         from its CULTURE's `leaderTitleMaker`, so the fix is a culture of our own; see
         `Defs/CultureDefs/JawaLeaderTitles.xml` for the full mechanism.
         ⛔ `Inherit="False"` IS LOAD-BEARING. `allowedCultures` is a list and the abstract
         parent supplies one, so a bare child node APPENDS and the game picks between the
         two at random - the title would then be right on roughly half of all worlds, which
         is worse than wrong because it looks fixed. -->
    <allowedCultures Inherit="False">
      <li>Jawa_Culture_Deepwater</li>
    </allowedCultures>

    <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>-97</configurationListOrderPriority>
    <categoryTag>Outlander</categoryTag>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <techLevel>Industrial</techLevel>
    <humanlikeFaction>true</humanlikeFaction>
    <canMakeRandomly>true</canMakeRandomly>
    <!-- 5 settlements, every oasis and coast. -->
    <settlementGenerationWeight>0.7</settlementGenerationWeight>
    <permanentEnemy>false</permanentEnemy>
    <naturalEnemy>false</naturalEnemy>
    <!-- The water caravan trades with EVERY faction, the Empire included. -->
    <canRequestTraders>true</canRequestTraders>
    <!-- Wardens dehydrate off-water. They never arrive as a raid. -->
    <raidsForbidden>true</raidsForbidden>

    <factionNameMaker>NamerFactionOutlander</factionNameMaker>
    <settlementNameMaker>NamerSettlementOutlander</settlementNameMaker>
    <factionIconPath>World/JawaFactions/DeepwaterCompact</factionIconPath>
    <!-- R22: teal. -->
    <colorSpectrum>
      <li>(0.20,0.55,0.58)</li>
      <li>(0.14,0.40,0.45)</li>
    </colorSpectrum>

    <!--
      ================================================================
      faction_religions_spec.md entry 7 (B54)
      ================================================================
      `ideoName` and `ideoDescription` are verbatim from the spec; they are
      the only strings the engine renders. Structure meme goes FIRST in
      `forcedMemes`. ⛔ `hiddenIdeo` MUST STAY UNSET — setting it suppresses
      the description entirely, which is the whole deliverable.
    -->
    <fixedIdeo>true</fixedIdeo>
    <requiredPreceptsOnly>true</requiredPreceptsOnly>
    <ideoName>the Balance</ideoName>
    <ideoDescription>Water is not a weapon and we will not let it be made into one. We sell to the farmer, and we sell to the fleet that burned the farmer, and both hate us exactly as much — that is how we know the Balance is holding. Choose a side and the whole world dies of thirst. Inside our walls no one raises a hand. Outside our walls, we do not go.</ideoDescription>
    <forcedMemes>
      <li>Structure_Ideological</li>
      <li MayRequire="sarg.alphamemes">AM_WaterPrimacy</li>
      <li MayRequire="vanillaexpanded.vmemese">VME_Pacifist</li>
      <li>Individualist</li>
      <li MayRequire="vanillaexpanded.vmemese">VME_Trader</li>
    </forcedMemes>

    <!-- R27: `xenotypeSet` is the SECOND inherit trap. `OutlanderFactionBase`
         ships five vanilla xenotypes (Hussar · Dirtmole · Genie · Neanderthal ·
         Starjack) and `PirateBandBase` ships nine; a child set is APPENDED to
         them, so without this opt-out the faction fields Hussars in a Star Wars
         campaign. The species below are this repo's own, copied out of the
         three colliding packs so none of them has to stay installed.
         ⚠️ The CHANCES are BUILD's, not the spec's — R27 gives species, not
         numbers. They sum to ~1.00, with the dossier
         lead species heaviest.
         ⚠️ Baseliner is one of the entries and it is NOT zero, so plain humans DO
         generate at that rate. The comment used to claim otherwise. Retune freely;
         nothing depends on them. -->
    <xenotypeSet Inherit="False">
      <xenotypeChances>
        <RSW_RimMandrakeMonCalamari MayRequire="mandrake.rsw.starwarsraces">0.222</RSW_RimMandrakeMonCalamari>
        <RSW_RimMandrakeNautolan MayRequire="mandrake.rsw.starwarsraces">0.222</RSW_RimMandrakeNautolan>
        <RSW_RimMandrakeQuarren MayRequire="mandrake.rsw.starwarsraces">0.222</RSW_RimMandrakeQuarren>
        <RSW_RimMandrakeChagrian MayRequire="mandrake.rsw.starwarsraces">0.074</RSW_RimMandrakeChagrian>
        <RSW_RimMandrakeHerglic MayRequire="mandrake.rsw.starwarsraces">0.074</RSW_RimMandrakeHerglic>
        <RSW_RimMandrakeSelkath MayRequire="mandrake.rsw.starwarsraces">0.074</RSW_RimMandrakeSelkath>
        <Baseliner>0.022</Baseliner>
        <RSW_RimMandrakeBith MayRequire="mandrake.rsw.starwarsraces">0.022</RSW_RimMandrakeBith>
        <RSW_RimMandrakeBothan MayRequire="mandrake.rsw.starwarsraces">0.022</RSW_RimMandrakeBothan>
        <RSW_RimMandrakeDuros MayRequire="mandrake.rsw.starwarsraces">0.022</RSW_RimMandrakeDuros>
        <RSW_RimMandrakeGungan MayRequire="mandrake.rsw.starwarsraces">0.022</RSW_RimMandrakeGungan>
      </xenotypeChances>
    </xenotypeSet>

    <!-- Inherit="False" IS LOAD-BEARING. RimWorld resolves inheritance AFTER
         patches, and a child `li` list is APPENDED to the parent's, not
         substituted for it. `OutlanderFactionBase` carries 8 group makers; without
         this opt-out the faction fields those too and raids arrive as
         vanilla pawns wearing our name. Vanilla itself writes it 314 times,
         9 of them on pawnGroupMakers. -->
    <pawnGroupMakers Inherit="False">
      <li>
        <!-- Never reaches the player: raidsForbidden. This is settlement defence. -->
        <kindDef>Combat</kindDef>
        <options>
          <Jawa_Deepwater_Grunt>10</Jawa_Deepwater_Grunt>
          <Jawa_Deepwater_Heavy>4</Jawa_Deepwater_Heavy>
          <Jawa_Deepwater_Specialist>2</Jawa_Deepwater_Specialist>
          <Jawa_Deepwater_Leader>1</Jawa_Deepwater_Leader>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <RSW_MonCalamari MayRequire="mandrake.rsw.starwarsraces">1</RSW_MonCalamari>
        </traders>
        <guards>
          <RSW_Quarren MayRequire="mandrake.rsw.starwarsraces">6</RSW_Quarren>
        </guards>
        <carriers>
          <Muffalo>6</Muffalo>
        </carriers>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Jawa_Deepwater_Grunt>10</Jawa_Deepwater_Grunt>
          <Jawa_Deepwater_Heavy>3</Jawa_Deepwater_Heavy>
          <Jawa_Deepwater_Specialist>2</Jawa_Deepwater_Specialist>
        </options>
      </li>
    </pawnGroupMakers>
  </FactionDef>

</Defs>
