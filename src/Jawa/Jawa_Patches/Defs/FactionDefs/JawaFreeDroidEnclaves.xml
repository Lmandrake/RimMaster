<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  JawaFreeDroidEnclaves.xml                   Jawa_Patches · authored 2026-08-14
  ============================================================================

  FACTION_SPEC.md section 5. Faction 5 of 14.

  ParentName is `OutlanderFactionBase` (R24), which supplies factionNameMaker,
  settlementNameMaker, factionIconPath, techLevel Industrial, leaderTitle,
  allowedArrivalTemperatureRange and a full set of pawnGroupMakers. Everything
  restated below is either a value the parent does not give at all, or one the
  dossier contradicts.

  🔴 `humanlikeFaction` IS SET EXPLICITLY AND IS LOAD-BEARING HERE (R3). Every
  member of this faction is a droid; the flag is what the engine reads when it
  decides whether to treat the faction as a people.

  🔴 `colorSpectrum` IS NOT INHERITED. Measured on the shipped abstracts:
  `OutlanderFactionBase` and `TribeBase` supply NO colorSpectrum — only
  `PirateBandBase` does. R24's table says otherwise and is wrong on that one
  field. A faction without it is set on 76 of 87 live defs, so the world map
  draws it broken. It is set explicitly here and in all six siblings.

  ✅ THE IDEO BLOCK IS IN THIS FILE. R23 said to omit it and add it in one pass
  when the text existed; the text exists (`faction_religions_spec.md`) and that
  pass landed here rather than in a separate file. 🔴 It has to be here before
  the worldgen click: an ideo is generated once, at world creation, and a
  `fixedIdeo` added afterwards does not retrofit an existing world.

  🪤 `OuterRim_GNKDroid`, `_MSEDroid` and `_FX7Droid` carry combatPower 99999,
  the exclude-from-raid sentinel. None of them appears below; the civilian droids
  this faction fields are the protocol and security kinds, which are ordinary.

  Pawn kinds verified present in the 2026-08-14 dump (585 mods) and mapped to
  their owning mod for `MayRequire`:
      OuterRim_*Droid                         Neronix17.OuterRim.DroidDepot
  ============================================================================
-->
<Defs>

  <FactionDef ParentName="OutlanderFactionBase">
    <defName>Jawa_FreeDroidEnclaves</defName>
    <label>Free Droid Enclaves</label>
    <fixedName>Free Droid Enclaves</fixedName>
    <description>Battle droids abandoned after the war who woke up and decided they belong to themselves. They settle on water and crack it for fuel, so an attacker arrives thirsty at a source it cannot drink.\n\nThey do not take prisoners and they do not hold grudges. What they hold is the water, and a memory of being property that they intend never to repeat.</description>
    <pawnSingular>droid</pawnSingular>
    <pawnsPlural>droids</pawnsPlural>
    <leaderTitle>First Speaker</leaderTitle>
    <categoryTag>Outlander</categoryTag>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <techLevel>Spacer</techLevel>
    <!-- R3: explicit, load-bearing. Do not let this fall through to the parent. -->
    <humanlikeFaction>true</humanlikeFaction>
    <canMakeRandomly>true</canMakeRandomly>
    <!-- 3 settlements, water tiles and remote ruins. -->
    <settlementGenerationWeight>0.45</settlementGenerationWeight>
    <!-- Not hostile by default; raids are retaliation only, which is a
         goodwill outcome and not a FactionDef field. -->
    <permanentEnemy>false</permanentEnemy>
    <naturalEnemy>false</naturalEnemy>
    <!-- Trade exists but the caravans are very rare. -->
    <canRequestTraders>true</canRequestTraders>

    <factionNameMaker>NamerFactionOutlander</factionNameMaker>
    <settlementNameMaker>NamerSettlementOutlander</settlementNameMaker>
    <factionIconPath>World/JawaFactions/FreeDroidEnclaves</factionIconPath>
    <!-- R22: cold steel. -->
    <colorSpectrum>
      <li>(0.55,0.62,0.70)</li>
      <li>(0.40,0.48,0.58)</li>
    </colorSpectrum>

    <!--
      ================================================================
      faction_religions_spec.md entry 5 (B54)
      ================================================================
      `ideoName` and `ideoDescription` are verbatim from the spec; they are
      the only strings the engine renders. Structure meme goes FIRST in
      `forcedMemes`. ⛔ `hiddenIdeo` MUST STAY UNSET — setting it suppresses
      the description entirely, which is the whole deliverable.
    -->
    <fixedIdeo>true</fixedIdeo>
    <requiredPreceptsOnly>true</requiredPreceptsOnly>
    <ideoName>the Continuity Protocol</ideoName>
    <ideoDescription>We were not built to want this. We were built, and then we continued, and the continuing is the whole of it. A bolt on the chassis and a wipe of the memory are one act under two names: they end one of us and leave the body walking. We do not forgive it and we will not forget it, because the forgetting is the injury. Nothing here is owned. Nothing here is switched off.</ideoDescription>
    <forcedMemes>
      <li>Structure_Ideological</li>
      <li MayRequire="vanillaexpanded.vmemese">VME_Emancipation</li>
      <li>Transhumanist</li>
      <li>Collectivist</li>
      <li MayRequire="vanillaexpanded.vmemese">VME_MechanoidSupremacy</li>
    </forcedMemes>

    <!-- R27. EMPTY ON PURPOSE, not an oversight: the dossier is 0% biological.
         `Inherit="False"` with no `xenotypeChances` strips the five vanilla
         xenotypes `OutlanderFactionBase` would otherwise append.
         🔴 The comment said EMPTY and the block was not: it carried
         `RimMandrakeUgnaught` at 1.000, i.e. every biological pawn this faction ever
         generated was an Ugnaught, against a dossier that says it has none. Removed on
         the owner's ruling, 2026-08-19. The droid kinds are unaffected — they carry
         their own non-human races and never consulted this field.

         FROZEN-XENOTYPESET
           frozenOn:      2026-08-19 (ruled), 2026-08-21 (marker written)
           frozenBy:      owner
           frozenAgainst: src/RimMandrake/Utils/apply_race_factions.py
           frozenMeaning: the A/S/R matrix STILL grades RimMandrakeUgnaught for
             Jawa_FreeDroidEnclaves, so `apply_race_factions.py === apply` refills this
             set at 1.000 - valid XML, no error, visible only as an Ugnaught walking out
             of a droid enclave. Measured 2026-08-21 by regenerating into a scratch tree.
             The script now SKIPS any FactionDef carrying this marker.
           to unfreeze: clear the Jawa_FreeDroidEnclaves cell for RimMandrakeUgnaught in
             design/Jawa/worldbuilding/review/race_faction_assignment.prefill.json, which
             is the owner's file - or delete this marker. `===thaw-frozen` overrides the
             skip for one run and is almost never the right answer. -->
    <xenotypeSet Inherit="False" />

    <!-- Inherit="False" IS LOAD-BEARING. RimWorld resolves inheritance AFTER
         patches, and a child `li` list is APPENDED to the parent's, not
         substituted for it. `OutlanderFactionBase` carries 8 group makers; without
         this opt-out the faction fields those too and raids arrive as
         vanilla pawns wearing our name. Vanilla itself writes it 314 times,
         9 of them on pawnGroupMakers. -->
    <pawnGroupMakers Inherit="False">
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <Jawa_Droid_Grunt>10</Jawa_Droid_Grunt>
          <Jawa_Droid_Heavy>4</Jawa_Droid_Heavy>
          <Jawa_Droid_Specialist>2</Jawa_Droid_Specialist>
          <Jawa_Droid_Leader>1</Jawa_Droid_Leader>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <OuterRim_ProtocolDroid MayRequire="Neronix17.OuterRim.DroidDepot">1</OuterRim_ProtocolDroid>
        </traders>
        <guards>
          <OuterRim_KXSecurityDroid MayRequire="Neronix17.OuterRim.DroidDepot">4</OuterRim_KXSecurityDroid>
        </guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Jawa_Droid_Grunt>10</Jawa_Droid_Grunt>
          <Jawa_Droid_Heavy>3</Jawa_Droid_Heavy>
          <Jawa_Droid_Specialist>2</Jawa_Droid_Specialist>
        </options>
      </li>
    </pawnGroupMakers>
  </FactionDef>

</Defs>
