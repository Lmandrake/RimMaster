<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ========================================================================
       Jawa ion damage. Modeled on vanilla EMP (ParentName="EMP") so we inherit
       vanilla's stun behavior and the built-in target gradient:
         * mechanoids / droids  -> EMP stuns them hard and fast (very effective)
         * flesh pawns          -> only briefly dazed per hit (resistant)
       harmsHealth=false / makesBlood=false guarantees CAPTURE-NOT-KILL: this
       damage never injures or kills a fleshy target. The "wear-down" that
       eventually drops a person alive comes from the Jawa_IonStun hediff below
       (applied via the projectile's comp), NOT from this damage dealing wounds.
       No custom workerClass -> no C# dependency.
  ======================================================================== -->
  <!-- We inherit ParentName="EMP", so ALL vanilla EMP stun behavior (causeStun,
       stun duration, the flesh-vs-mech resistance gradient) comes for free.
       We only override what makes this "ion": labels, no-harm guarantee, tint,
       and the buildup hediff. We intentionally do NOT re-declare stun fields we
       cannot verify against 1.6 — inheritance handles them. -->
  <!-- FIXED 2026-08-10. This said ParentName="EMP" and the def was being
       DISCARDED every load: "Could not find parent node named EMP for node
       DamageDef". EMP is a CONCRETE def (defName EMP), and ParentName can only
       reference an ABSTRACT def declared with a Name= attribute. Core's own EMP
       does exactly what we now do: ParentName="StunBase", where StunBase is
       DamageDef Name="StunBase" Abstract="True" in Core Damages_Stun.xml.
       Consequence while broken: no ion damage type existed, so the weapon's
       damageDef and the JawaIon_Stun hediff never resolved. -->
  <DamageDef ParentName="StunBase">
    <defName>JawaIon_Damage</defName>
    <label>ion</label>
    <deathMessage>{0} was overloaded by ion fire.</deathMessage>
    <harmsHealth>false</harmsHealth>
    <makesBlood>false</makesBlood>
    <explosionColorEdge>(0.55, 0.75, 1.0, 0.85)</explosionColorEdge>
    <!-- Each hit deposits ion buildup. severityPerDamageDealt is multiplied by
         the damage amount (8) -> ~0.24 severity per bolt, so ~4 solid hits push
         a flesh target from 0 toward the ~0.9 "overloaded" collapse stage, and
         decay (-1.2/day) bleeds it off if fire stops. This is the vanilla,
         no-C# way to apply an accumulating hediff on damage. VERIFY IN-GAME:
         confirm severity actually accrues on FLESH pawns (EMP on flesh is a
         short stun; additionalHediffs should still apply regardless). -->
    <!-- ADDED 2026-08-11 - THE GUN DID NOTHING AT ALL.
         Reported in-game as "it never seems to hit, even with 20 shooting".
         It was hitting every time; the hit simply had no effect of any kind.
         Core's StunBase (Damages_Stun.xml) declares ONLY harmsHealth=false and
         makesBlood=false. It carries no workerClass and, crucially, no
         causeStun. Vanilla EMP is not stunning because it descends from
         StunBase - it stuns because EMP itself sets causeStun=true. We
         inherited the "harms nothing" half of EMP and none of the "does
         something" half, so every bolt landed as a no-op: no injury, no blood,
         no stun, no message. Indistinguishable from a miss. -->
    <causeStun>true</causeStun>
    <externalViolenceForMechanoids>true</externalViolenceForMechanoids>
    <stunAdaptationTicks>2200</stunAdaptationTicks>
    <impactSoundType>Electric</impactSoundType>
    <combatLogRules>Damage_EMP</combatLogRules>

    <!-- KNOWN INERT: the additionalHediffs block below does not fire.
         additionalHediffs is read by DamageWorker_AddInjury.ApplyDamageToPart,
         and a StunBase-derived def never reaches that worker - in Core the only
         defs using additionalHediffs are injury damages (Damages_MeleeWeapon).
         So the flesh "wear-down toward a live collapse" mechanic has never run
         and cannot run from XML alone. Left in place, harmless, because the fix
         is a decision not a typo: either a small custom DamageWorker in C#, or
         an injury-based damage def, which trades away the capture-not-kill
         guarantee. Do not delete this until that is settled. -->
    <additionalHediffs>
      <li>
        <hediff>JawaIon_Stun</hediff>
        <severityPerDamageDealt>0.03</severityPerDamageDealt>
      </li>
    </additionalHediffs>
  </DamageDef>

</Defs>
