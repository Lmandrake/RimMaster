{
  "env": {
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/src/RimMandrake/Utils/statusline.py\"",
    "padding": 1
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block_blind_scan.py\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Checking the scan can read the artifact"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block_blanket_git_stage.py\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Checking git staging scope"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/warn_unclosed_queue_item.py\"",
            "timeout": 10,
            "statusMessage": "Checking for a Closes: trailer"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/warn_doc_budget.py\"",
            "timeout": 10,
            "statusMessage": "Checking documentation budget"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/queue_lint.py\"",
            "timeout": 20,
            "statusMessage": "Checking the ledger and the generated views"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block_canon_contradiction.py\"",
            "timeout": 60,
            "statusMessage": "Checking design docs against canon"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/queue_lint.py\"",
            "timeout": 20,
            "statusMessage": "Checking nothing but rimflow writes the ledger"
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block_peer_messages.py\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Checking the message target is your own subagent"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/warn_skill_unwired.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/set_session_title.py\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Naming this conversation"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/set_session_title.py\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Naming this conversation"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/block_paste_handoff.py\" 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "crossSessionInbound": "accept",
  "permissions": {
    "deny": [
      "ListAgents"
    ]
  }
}
