#!/usr/bin/env bash
# game — announce the game's state in one word.
#
# 🔴 OWNER, 2026-08-22: *"make it so that when I say game up, game down, game loading
# it is IDENTICAL to that !./game command. Fix it for this specific thing."*
# ⇒ WHEN HE SAYS IT, THE AGENT RUNS THIS. Not a stamp, not a paraphrase — this exact
# command, so the other windows hear it in the same breath the ledger is written. That
# is the ONLY thing an agent may run this for: relaying his words the moment he says
# them. Announcing a state you INFERRED is still the thing the ruling forbids.
# ⭐ Add `--said "<his words>"` and the quote is recorded on the ledger event as the
# authorization; without it the event is still OWNER's, just unattributed.
#
#     ./game up            ./game down        ./game loading
#     ./game deploying     ./game going-down
#     ./game up "started for the vehicle look"      <- optional note, appended
#     ./game                                        <- what does the board think?
#
# WHY THIS EXISTS. Owner, 2026-08-21: *"we need a simple broadcast way to do this,
# not running Python3. That's too elaborate."* The mechanism was already right —
# `broadcast.py` recognises a game-state sentence and appends the OWNER's `game`
# event to the ledger itself — but reaching it meant typing a python3 path.
#
# 🔑 THIS IS A WRAPPER, NOT A SECOND MECHANISM. It builds the sentence and hands it
# to broadcast.py, so it does BOTH things at once and cannot drift from it:
#   1. every agent window is told, which is the one message that legitimately
#      crosses windows and is the OWNER's to send;
#   2. the ledger is stamped, so `rimflow next` starts offering or withholding the
#      items whose `needs` depends on it.
# ⚠️ Stamping without announcing, or announcing without stamping, is how the board
# came to read DOWN while RimWorld was running.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bc="$here/src/RimMandrake/Utils/broadcast.py"

if [ $# -eq 0 ]; then
    # No argument: MEASURE it. Owner, 2026-08-22: *"Any agent is absolutely able to check
    # what it literally is... there should be precisely ONE place that variable is
    # recorded and no more."* So this does not compare two readings and shrug — it takes
    # the reading, corrects the ledger from it, and says what it did. One mechanism, and
    # the same one every seat gets from `rimflow game`.
    exec python3 "$here/src/RimMandrake/rimflow/cli.py" game
fi

# ⭐ --help exits ZERO and lists the states. Added 2026-08-21 after
# `.claude/hooks/selftest_documented_commands.py` found this documented three times in
# CLAUDE.md while `./game --help` exited 2 — the exact class of defect that test exists
# to catch, caught on its first run.
# 🔴 HELP IS MATCHED IN ANY POSITION, not just $1 — fixed 2026-08-25.
# It used to be `case "${1}"`, so `./game --help` printed help but `./game up --help`
# fell through to the note-append below and BROADCAST "Game is up — --help" to every
# window, stamping an UP event with no `ownerSaid`. That happened twice on 2026-08-25,
# two minutes apart, and cost the seats two false announcements each. A flag anywhere
# in the line is a request for the usage, never a message.
for _a in "$@"; do
    case "$_a" in -h|--help|help) set -- --help ;; esac
done

case "${1}" in
    -h|--help|help)
        echo "usage: ./game [--said \"<owner's words>\"] up|down|loading|deploying|going-down [\"note\"]"
        echo
        echo "  up           the game is live and usable"
        echo "  down         no RimWorld process — the only window assemblies can be written"
        echo "  loading      launched, not yet at a menu"
        echo "  deploying    files going to the Steam Mods tree"
        echo "  going-down   about to close — last call for anything needing the live game"
        echo
        echo "  ./game       with no argument: what the board thinks vs what is running"
        echo
        echo "  --said \"…\"  an agent relaying the owner's spoken words, verbatim."
        echo "               🔴 That is the ONLY reason an agent runs this. Never a state it inferred."
        echo
        echo "Announces to every agent window AND stamps the ledger, in one act."
        echo "🔴 The owner's, and an agent's ONLY when relaying his words as he says them."
        exit 0 ;;
esac

# ⭐ `--said "<his words>"` — provenance, not permission. An agent relaying the owner
# passes his verbatim sentence through to the ledger event; `rimflow`'s own guard then
# refuses bare assent ("yes") in place of an instruction ("game up").
said=""
if [ "${1:-}" = "--said" ]; then
    said="${2:-}"; shift 2
    [ $# -eq 0 ] && { echo "--said takes his words, then the state: ./game --said \"game up\" up" >&2; exit 2; }
fi
export RIMFLOW_OWNER_SAID="$said"

case "${1,,}" in
    up)                 sentence="Game is up" ;;
    down)               sentence="Game is down" ;;
    loading)            sentence="Game is loading" ;;
    deploying)          sentence="Deploying" ;;
    going-down|going_down|wrap) sentence="Game is going down" ;;
    *)  echo "unknown state '${1}'." >&2
        echo "usage: ./game up|down|loading|deploying|going-down [\"note\"]" >&2
        exit 2 ;;
esac
shift
# ⛔ A note may never start with a dash. The note slot is free text appended after an
# em dash and sent to every window; a flag landing here is always a mistyped command,
# never something the owner meant to say. Refusing costs nothing and the alternative
# is a false announcement — see the help note above for what that looked like.
for _a in "$@"; do
    case "$_a" in -*)
        echo "refusing: '$_a' looks like a flag, not a note." >&2
        echo "the note is free text appended to the announcement and sent to EVERY window." >&2
        echo "for the usage:  ./game --help" >&2
        exit 2 ;;
    esac
done
[ $# -gt 0 ] && sentence="$sentence — $*"

exec python3 "$bc" "$sentence"
