		<questManager>
			<quests>
				<li>
					<name>The Gravship</name>
					<appearanceTick>1</appearanceTick>
					<acceptanceTick>1</acceptanceTick>
					<acceptedBy>null</acceptedBy>
					<initiallyAccepted>True</initiallyAccepted>
					<challengeRating>4</challengeRating>
					<description>You've discovered a mechanoid grav engine! You can use this to build a gravship to quickly move around the planet.

The engine includes tech that passively scans for nearby gravship technology. If you obtain this gravship tech, you can upgrade your gravship over time.</description>
					<root>GravEngine</root>
					<signalsReceivedDebug IsNull="True" />
					<parts>
						<li Class="QuestPart_SubquestGenerator_Gravcores">
							<inSignalEnable>Quest0.Initiate</inSignalEnable>
							<state>Enabled</state>
							<enableTick>1</enableTick>
							<subquestDefs>
								<li>Gravcore_MechanoidRelay</li>
								<li>Gravcore_InsectLair</li>
								<li>Gravcore_AncientReactor</li>
								<li>Gravcore_OrbitalMechanoidPlatform</li>
								<li>Gravcore_AncientStockpile</li>
								<li>Gravcore_CrashedMechanoidPlatform</li>
								<li>Gravcore_OrbitalAncientPlatform</li>
								<li>Gravcore_FrozenTerraformer</li>
