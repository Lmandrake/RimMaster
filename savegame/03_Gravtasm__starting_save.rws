						<id>46</id>
						<development IsNull="True" />
					</li>
					<li>
						<overriddenWorshipRoomLabel>Sufficiently Whelming Temple</overriddenWorshipRoomLabel>
						<foundation Class="IdeoFoundation_Deity">
							<def>Deity</def>
							<place>Sophiamunda</place>
							<deities />
						</foundation>
						<name>United Senseans</name>
						<adjective>Sensean</adjective>
						<memberName>Sensean</memberName>
						<leaderTitleMale>Unifier</leaderTitleMale>
						<leaderTitleFemale>Unifier</leaderTitleFemale>
						<description>Against all odds, all differences, all senses, a few thousand of the Senseans of all kinds have found a borderline-impossible method of living in harmony, unified in equal levels of whelming and stimulation.

With no sense dominating, and a universally medium level of engagement, the Senseans have no only overcome their differences, but it is the differences themselves that become their greatest strength. 

By working together the United Senseans have the potential to be greater than the sum of their parts, which is five.</description>
						<descriptionLocked>True</descriptionLocked>
						<culture>Sophian</culture>
						<iconDef>oracle_Ideoligion_MCRN</iconDef>
						<colorDef>LightBlue</colorDef>
						<memes>
							<li>Structure_Archist</li>
							<li>HumanPrimacy</li>
							<li>VME_Republic</li>
							<li>VME_Egalitarian</li>
							<li>VME_Pacifist</li>
							<li>VME_CityBuilders</li>
						</memes>
						<precepts>
							<li>
								<name>raiding</name>
								<def>VME_Raiding_Abhorrent</def>
								<ID>5282</ID>
								<randomSeed>-2037324263</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li>
								<name>leader</name>
								<def>VME_Leader_Three</def>
								<ID>5283</ID>
								<randomSeed>-262020320</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li>
								<name>violence</name>
								<def>VME_Violence_Abhorrent</def>
								<ID>5284</ID>
								<randomSeed>-1888091695</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li Class="Precept_Ritual">
								<name>Peace-Monger Festival</name>
								<def>Adoption</def>
								<ID>5285</ID>
								<randomSeed>-90161483</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<descOverride>A speaker speaks for a while, then the adoptee lies on the altar and is officially adopted by the parent</descOverride>
								<nameMaker>NamerRitualFestival</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<shortDescOverride>adoption ritual</shortDescOverride>
								<iconPathOverride>UI/Icons/Rituals/Adoption</iconPathOverride>
								<patternGroupTag>Adopt</patternGroupTag>
								<isAnytime>True</isAnytime>
								<canBeAnytime>True</canBeAnytime>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>Adoption</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_AnyGatherSpotOrAltar">
									<def>GatheringSpotOrAltar</def>
									<parent>Precept_5285</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior>
									<def>Adopt</def>
								</behavior>
								<triggers>
									<li Class="RitualObligationTrigger_Date">
										<mustBePlayerIdeo>True</mustBePlayerIdeo>
										<triggerDaysSinceStartOfYear>35</triggerDaysSinceStartOfYear>
									</li>
								</triggers>
								<outcomeEffect Class="TPRitualAttachableOutcomes.RitualOutcomeEffectWorker_FromQuality_TP_Custom">
									<def>AdoptionOutcome</def>
									<compDatas>
										<li IsNull="True" />
										<li IsNull="True" />
										<li Class="RitualOutcomeComp_DataThingPresence">
											<presentForTicks>
												<keys />
												<values />
											</presentForTicks>
										</li>
										<li IsNull="True" />
										<li IsNull="True" />
									</compDatas>
								</outcomeEffect>
								<layerWhitelist IsNull="True" />
								<layerBlacklist IsNull="True" />
								<activeObligations IsNull="True" />
								<completedObligations IsNull="True" />
								<lastFinishedTick>-1</lastFinishedTick>
							</li>
							<li Class="Precept_Ritual">
								<name>funeral (no corpse)</name>
								<def>AM_FuneralNoCorpse</def>
								<ID>5286</ID>
								<randomSeed>-787093475</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
