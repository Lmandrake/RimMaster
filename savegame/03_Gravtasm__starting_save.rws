						<name>Technologism</name>
						<adjective>technologistic</adjective>
						<memberName>Technologist</memberName>
						<leaderTitleMale>Exochrome Captain</leaderTitleMale>
						<leaderTitleFemale>Exochrome Captain</leaderTitleFemale>
						<description>Since their emergence, archotechs have extended their consciousness amongst the stars. A multiply-embodied consciousness. All of them but one node of a distributed network. Some day, the archotechs will depart. Only those who are sufficiently augmented will be allowed to go with them.</description>
						<descriptionTemplate>Since their emergence, archotechs have extended their consciousness amongst the stars. A multiply-embodied consciousness. All of them but one node of a distributed network. Some day, the archotechs will depart. Only those who are sufficiently augmented will be allowed to go with them.</descriptionTemplate>
						<culture>Astropolitan</culture>
						<iconDef>AbstractsE</iconDef>
						<colorDef>DarkPink</colorDef>
						<primaryFactionColor>RGBA(0.550, 0.290, 0.210, 1.000)</primaryFactionColor>
