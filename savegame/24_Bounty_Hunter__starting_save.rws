						<name>Confederacy of Independent Systems</name>
						<adjective>Separatist</adjective>
						<memberName>Separatist</memberName>
						<leaderTitleMale>Techno Booster</leaderTitleMale>
						<leaderTitleFemale>Techno Booster</leaderTitleFemale>
						<description>The Confederacy of Independent Systems are a collection of planets seeking indepedence from the Republic and their perceived overextension and restrictive bureaucracy. They leverage their extensive wealth and connections to rapidly produce combat droid combat forces. </description>
						<descriptionLocked>True</descriptionLocked>
						<culture>Rustican</culture>
						<iconDef>Ideoligion_StarWarsE</iconDef>
