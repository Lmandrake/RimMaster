							<styleForThingDef>
								<keys>
									<li>Ideogram</li>
									<li>Apparel_CollarShirt</li>
								</keys>
								<values>
									<li>
										<category>Hindu</category>
										<styleDef>Hindu_IdeogramB</styleDef>
									</li>
