					</li>
					<li>
						<foundation Class="IdeoFoundation_Deity">
							<def>Deity</def>
							<place>Sophiamunda</place>
							<deities />
						</foundation>
						<name>Philosophy of Archism</name>
						<adjective>archist</adjective>
						<memberName>Archist</memberName>
						<leaderTitleMale>High Stellarch</leaderTitleMale>
						<leaderTitleFemale>High Stellarch</leaderTitleFemale>
						<description>Archotechs are machines of vast will and power, but only humanity could create them. Archotechs touch every human consciousness directly on a regular basis, imparting wisdom only to those that seek the knowledge of the archotechs. In the end, the archotechs will depart. Only those who are sufficiently augmented will be allowed to go with them.</description>
						<descriptionTemplate>Archotechs are machines of vast will and power, but only humanity could create them. Archotechs touch every human consciousness directly on a regular basis, imparting wisdom only to those that seek the knowledge of the archotechs. In the end, the archotechs will depart. Only those who are sufficiently augmented will be allowed to go with them.</descriptionTemplate>
						<culture>Sophian</culture>
						<iconDef>Ideoligion_SpaceH</iconDef>
						<colorDef>DarkTeal</colorDef>
						<primaryFactionColor>RGBA(1.000, 1.000, 1.000, 1.000)</primaryFactionColor>
						<memes>
							<li>Structure_Archist</li>
							<li>Loyalist</li>
							<li>Transhumanist</li>
							<li>HumanPrimacy</li>
						</memes>
						<precepts>
							<li Class="Precept_Ritual">
								<name>funeral (no corpse)</name>
								<def>AM_FuneralNoCorpse</def>
								<ID>3319</ID>
								<randomSeed>-1416338090</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>Once a {IDEO} member dies and the body is lost, other {MEMBERS} gather around an empty grave for {RITUAL_labelDef}.</ritualExpectedDesc>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>AM_FuneralNoCorpsePattern</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_AnyEmptyGrave">
									<def>AnyEmptyGrave</def>
									<parent>Precept_3319</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior Class="RitualBehaviorWorker_Funeral">
									<def>Funeral</def>
								</behavior>
								<triggers>
									<li Class="AlphaMemes.RitualObligationTrigger_NoCorpse">
										<mustBePlayerIdeo>True</mustBePlayerIdeo>
									</li>
								</triggers>
								<outcomeEffect Class="RitualOutcomeEffectWorker_FromQuality">
									<def>AttendedFuneralNoCorpse</def>
									<compDatas>
										<li IsNull="True" />
										<li Class="RitualOutcomeComp_DataThingPresence">
											<presentForTicks>
												<keys />
												<values />
											</presentForTicks>
										</li>
									</compDatas>
								</outcomeEffect>
								<activeObligations IsNull="True" />
								<completedObligations IsNull="True" />
								<lastFinishedTick>-1</lastFinishedTick>
							</li>
							<li>
								<name>body modification</name>
								<def>BodyMod_Approved</def>
								<ID>3323</ID>
								<randomSeed>1594440144</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li Class="Precept_Ritual">
								<name>Archist Requiem</name>
								<def>Funeral</def>
								<ID>3386</ID>
								<randomSeed>-821516454</randomSeed>
