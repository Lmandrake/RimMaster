						<fluid>True</fluid>
						<id>112</id>
						<development />
					</li>
					<li>
						<foundation Class="IdeoFoundation_Deity">
							<def>Deity</def>
							<place>OuterRim_Chandrila</place>
							<deities>
								<li>
									<name>Horax</name>
									<type>God of the Void</type>
									<gender>Male</gender>
									<iconPath>UI/Deities/DeityGeneric</iconPath>
								</li>
							</deities>
						</foundation>
						<name>Nightmare Deep</name>
						<adjective>Republic</adjective>
						<memberName>Citizen</memberName>
						<leaderTitleMale>Senator</leaderTitleMale>
						<leaderTitleFemale>Senator</leaderTitleFemale>
						<description>You see space as a grid, pure and mathematical. We know it is only the glassy surface of a black ocean of nightmares buried under every place and every moment. We know the mind who reigns from the deep. Its thoughts reach up from the boiling darkness and reward those who serve its will.</description>
						<descriptionTemplate>Archotechs are the next natural step in the development of consciousness. Archotechs can do anything; the only reason they let us live and choose is to judge us better. Some day, as archotechs grow, they will become the universe and integrate humanity into themselves. Then we will truly become conscious.</descriptionTemplate>
						<culture>OuterRim_CultureRepublic</culture>
						<iconDef>OuterRim_Republic</iconDef>
						<colorDef>DarkSapphire</colorDef>
						<primaryFactionColor>RGBA(0.110, 0.478, 0.400, 1.000)</primaryFactionColor>
						<memes>
							<li>Structure_Archist</li>
						</memes>
						<precepts>
							<li>
								<name>research</name>
								<def>Research_Slow</def>
								<ID>10047</ID>
								<randomSeed>-342506327</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
							</li>
							<li Class="Precept_Ritual">
								<name>funeral (no corpse)</name>
								<def>AM_FuneralNoCorpse</def>
								<ID>10051</ID>
								<randomSeed>-402729187</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>Once a {IDEO} member dies and the body is lost, other {MEMBERS} gather around an empty grave for {RITUAL_labelDef}.</ritualExpectedDesc>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>AM_FuneralNoCorpsePattern</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_AnyEmptyGrave">
									<def>AnyEmptyGrave</def>
									<parent>Precept_10051</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior Class="RitualBehaviorWorker_Funeral">
									<def>Funeral</def>
								</behavior>
								<triggers>
									<li Class="AlphaMemes.RitualObligationTrigger_NoCorpse">
										<mustBePlayerIdeo>True</mustBePlayerIdeo>
									</li>
								</triggers>
								<outcomeEffect Class="RitualOutcomeEffectWorker_FromQuality">
									<def>AttendedFuneralNoCorpse</def>
									<compDatas>
										<li IsNull="True" />
										<li Class="RitualOutcomeComp_DataThingPresence">
											<presentForTicks>
												<keys />
												<values />
											</presentForTicks>
										</li>
									</compDatas>
								</outcomeEffect>
								<activeObligations IsNull="True" />
								<completedObligations IsNull="True" />
								<lastFinishedTick>-1</lastFinishedTick>
							</li>
							<li Class="Precept_Ritual">
								<name>Republic Requiem</name>
								<def>AM_RumBurial</def>
								<ID>10091</ID>
								<randomSeed>1603991485</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<nameMaker>NamerRitualFuneral</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>Once a {IDEO} member dies, other {MEMBERS} witnesss {RITUAL_labelDef} to liquorize their friend</ritualExpectedDesc>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>AM_RumBurialPattern</sourcePattern>
								<obligationTargetFilter Class="AlphaMemes.RitualObligationTargetWorker_FuneralThingExtended">
									<def>AM_RumFuneralExtended</def>
									<parent>Precept_10091</parent>
									<filters>
										<li Class="AlphaMemes.RitualObligationTargetWorker_FuneralHolderThings">
											<def>AM_RumBurialTarget</def>
											<parent>Precept_10091</parent>
										</li>
									</filters>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior Class="AlphaMemes.RitualBehaviorWorker_RumBurial">
									<def>AM_RumBurialBehavior</def>
									<corpse>null</corpse>
									<effecterpawn>null</effecterpawn>
									<spawnEffectThings />
								</behavior>
								<triggers>
									<li Class="RitualObligationTrigger_MemberDied">
										<mustBePlayerIdeo>True</mustBePlayerIdeo>
									</li>
								</triggers>
								<outcomeEffect Class="AlphaMemes.RitualOutcomeEffectWorker_RumBurial">
									<def>AM_RumBurialOutcome</def>
									<compDatas>
										<li IsNull="True" />
										<li Class="RitualOutcomeComp_DataThingPresence">
											<presentForTicks>
												<keys />
												<values />
											</presentForTicks>
										</li>
									</compDatas>
								</outcomeEffect>
								<activeObligations IsNull="True" />
								<completedObligations IsNull="True" />
								<lastFinishedTick>-1</lastFinishedTick>
							</li>
							<li Class="Precept_Ritual">
								<name>Dark Advent</name>
								<def>Festival</def>
								<ID>10058</ID>
								<randomSeed>925650628</randomSeed>
								<usesDefiniteArticle>True</usesDefiniteArticle>
								<descOverride>A social ritual where people release skylanterns. Participants will assemble wooden skylanterns while socializing, then release them and watch them drift away.</descOverride>
								<nameMaker>NamerRitualFestival</nameMaker>
								<ritualOnlyForIdeoMembers>True</ritualOnlyForIdeoMembers>
								<ritualExpectedDesc>Every year on {DATE}, {MEMBERS} can have a special celebration.</ritualExpectedDesc>
								<shortDescOverride>skylantern festival</shortDescOverride>
								<iconPathOverride>UI/Icons/Rituals/CelebrationPartySkylanterns</iconPathOverride>
								<patternGroupTag>CelebratedDate</patternGroupTag>
								<isAnytime>True</isAnytime>
								<canBeAnytime>True</canBeAnytime>
								<playsIdeoMusic>True</playsIdeoMusic>
								<generatedAttachedReward>True</generatedAttachedReward>
								<sourcePattern>CelebrationSkyLanterns</sourcePattern>
								<obligationTargetFilter Class="RitualObligationTargetWorker_SkyLanterns">
									<def>CampfireSkylanterns</def>
									<parent>Precept_10058</parent>
								</obligationTargetFilter>
								<targetFilter IsNull="True" />
								<behavior>
									<def>CelebrationSkyLanterns</def>
								</behavior>
								<triggers>
									<li Class="RitualObligationTrigger_Date">
										<mustBePlayerIdeo>True</mustBePlayerIdeo>
										<triggerDaysSinceStartOfYear>2</triggerDaysSinceStartOfYear>
